# Anaira CRM environment template
# Copy to .env.local for local development or configure in Vercel Project Settings.
# Never commit real secrets. Do not use the service-role key in browser/client code.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANAIRA_SECRET_KEY=
CRON_SECRET=

# Payments (configure only the provider you actually use)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OTP / notifications
RESEND_API_KEY=
RESEND_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google OAuth / integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
OPENAI_API_KEY=

# SEO data providers (optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# E2E only - never use production customer credentials in test automation
BASE_URL=
E2E_TENANT_A_TOKEN=
E2E_TENANT_B_TOKEN=
E2E_TENANT_B_ID=
