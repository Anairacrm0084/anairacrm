# Anaira CRM server environment
# Required for Supabase-backed OTP and booking APIs
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: preferred dedicated OTP signing secret. If omitted, the OTP route
# derives a separate server-side secret from SUPABASE_SERVICE_ROLE_KEY.
ANAIRA_SECRET_KEY=

# Required to actually deliver Email OTP
RESEND_API_KEY=
RESEND_FROM=

# Required only for Phone OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
