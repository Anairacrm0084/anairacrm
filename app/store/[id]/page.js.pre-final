'use client';
import {useEffect,useMemo,useState} from 'react';
import {useParams,useSearchParams} from 'next/navigation';
import {supabase} from '../../../lib/supabase';

const GLOBAL_KEYS=['restaurant_home_title','restaurant_home_subtitle','restaurant_home_theme','restaurant_home_primary_color','restaurant_home_accent_color','restaurant_home_surface_color','restaurant_home_background_color','restaurant_home_text_color','restaurant_home_card_radius','restaurant_home_show_search','restaurant_home_show_offers','restaurant_home_show_popular','restaurant_home_show_banners','restaurant_home_show_footer','restaurant_home_hero_image','restaurant_home_hero_mobile_image','restaurant_home_hero_overlay','restaurant_home_hero_cta','restaurant_home_hero_cta_url','restaurant_home_footer_text'];
const defaults={restaurant_home_title:'Discover great food',restaurant_home_subtitle:'Local restaurants, live menus and direct ordering.',restaurant_home_theme:'forest',restaurant_home_primary_color:'#073b2b',restaurant_home_accent_color:'#d4aa4c',restaurant_home_surface_color:'#ffffff',restaurant_home_background_color:'#f7f7f5',restaurant_home_text_color:'#17352a',restaurant_home_card_radius:20,restaurant_home_show_search:true,restaurant_home_show_offers:true,restaurant_home_show_popular:true,restaurant_home_show_banners:true,restaurant_home_show_footer:true,restaurant_home_hero_image:'',restaurant_home_hero_mobile_image:'',restaurant_home_hero_overlay:.45,restaurant_home_hero_cta:'Order Now',restaurant_home_hero_cta_url:'',restaurant_home_footer_text:'Anaira Food — discover restaurants, order food and enjoy local dining.'};
function val(row){return row?.value?.value??row?.value}
export default function RestaurantStore(){
 const {id}=useParams(); const searchParams=useSearchParams(); const [loading,setLoading]=useState(true),[r,setR]=useState(null),[global,setGlobal]=useState(defaults),[membership,setMembership]=useState(null),[settings,setSettings]=useState(null),[banners,setBanners]=useState([]),[featured,setFeatured]=useState([]),[categories,setCategories]=useState([]),[items,setItems]=useState([]),[offers,setOffers]=useState([]),[cart,setCart]=useState([]),[selected,setSelected]=useState(null),[variants,setVariants]=useState([]),[addons,setAddons]=useState([]),[chosenVariant,setChosenVariant]=useState(null),[chosenAddons,setChosenAddons]=useState([]),[q,setQ]=useState(''),[category,setCategory]=useState('all'),[mode,setMode]=useState('delivery'),[coupon,setCoupon]=useState(''),[form,setForm]=useState({name:'',phone:'',address:''}),[msg,setMsg]=useState(''),[busy,setBusy]=useState(false),[heroIndex,setHeroIndex]=useState(0);
 useEffect(()=>{if(!id)return;(async()=>{try{
   const storesQ=await supabase.from('anaira_platform_stores').select('id,enabled,published,store_name,slug').eq('store_type','restaurant').eq('enabled',true).eq('published',true).limit(10);
   const store=(storesQ.data||[])[0];
   if(!store){setMsg(storesQ.error?.message||'Restaurant marketplace is not configured.');setLoading(false);return}
   const membershipsQ=await supabase.from('anaira_store_memberships').select('*').eq('restaurant_id',id).eq('store_id',store.id).eq('enabled',true).limit(10);
   const membershipRow=(membershipsQ.data||[])[0];
   if(!membershipRow){setMsg(membershipsQ.error?.message||'This restaurant is not published in the Restaurant Store.');setLoading(false);return}
   const property={id,store_id:store.id,name:membershipRow.listing_override?.title||'Restaurant',slug:membershipRow.listing_override?.slug||id,logo:membershipRow.listing_override?.logo_url||'',cover_image:membershipRow.listing_override?.cover_url||'',cuisine:membershipRow.listing_override?.cuisine||'',address:membershipRow.listing_override?.address||'',city:membershipRow.listing_override?.city||'',phone:membershipRow.listing_override?.phone||'',website:membershipRow.listing_override?.website||'',listing_override:membershipRow.listing_override||{},store_config:membershipRow.store_config||{},catalog_source:membershipRow.catalog_source||'local'};
   const [{data:ss},{data:g},{data:globalBanners},{data:localBanners},{data:fi},{data:localCategories},{data:localMenuRows},{data:localOffers},{data:live}]=await Promise.all([
    supabase.from('anaira_store_settings').select('*').eq('restaurant_id',property.id).eq('store_id',property.store_id).eq('store_type','restaurant').limit(10),
    supabase.from('anaira_platform_settings').select('key,value').in('key',GLOBAL_KEYS),
    supabase.from('anaira_store_banners').select('*').is('restaurant_id',null).eq('active',true).order('display_order'),
    supabase.from('anaira_store_banners').select('*').eq('restaurant_id',property.id).eq('active',true).order('display_order'),
    supabase.from('anaira_marketplace_featured_items').select('*').eq('restaurant_id',property.id).eq('active',true).order('display_order'),
    supabase.from('anaira_store_categories').select('*').eq('restaurant_id',property.id).eq('active',true).order('display_order').order('name'),
    supabase.from('anaira_marketplace_menu_items').select('*').eq('restaurant_id',property.id).eq('active',true).order('display_order').order('item_name').limit(1000),
    supabase.from('anaira_store_offers').select('*').eq('restaurant_id',property.id).eq('active',true).order('created_at',{ascending:false}),
    fetch(`/api/marketplace/restaurant/${property.id}`,{cache:'no-store'}).then(x=>x.json()).catch(e=>({ok:false,error:e.message}))
   ]);
   const resolvedStore=store||live?.store;
   if(!resolvedStore?.enabled||!resolvedStore?.published){setMsg('Restaurant marketplace is not currently published.');setLoading(false);return}
   // The public Store ID is the primary store. The Restaurant SaaS bridge is optional enrichment.
   // Never make a local Store Builder page unavailable just because the integration API fails.
   const membershipData=membershipRow;
   const resolvedMembership=membershipData||live?.membership||{restaurant_id:property.id,enabled:true,listing_override:property.listing_override||{},store_config:property.store_config||{},catalog_source:'local'};
   const gg={...defaults};(g||[]).forEach(x=>gg[x.key]=val(x));setGlobal(gg);setMembership(resolvedMembership);setSettings((ss||[])[0]||live?.settings||null);setR({...property,...(live?.restaurant||{}),...(resolvedMembership.listing_override||{}),listing_override:resolvedMembership.listing_override||{},store_config:resolvedMembership.store_config||{}});
   const snapshot=live?.ok?live.data||{}:{};
   const rawMenu=(Array.isArray(snapshot.menu)&&snapshot.menu.length?snapshot.menu:(localMenuRows||[]));
   const rawCategories=(Array.isArray(snapshot.categories)&&snapshot.categories.length?snapshot.categories:(localCategories||[]));
   const rawOffers=(Array.isArray(snapshot.offers)&&snapshot.offers.length?snapshot.offers:(localOffers||[]));
   const featuredRows=fi||[];
   const featuredIds=new Set(featuredRows.map(x=>String(x.external_item_id)));
   const menu=rawMenu.map(i=>{const f=featuredRows.find(x=>String(x.external_item_id)===String(i.id));return {...i,id:i.id,item_name:i.item_name||i.name,description:i.description,price:i.price,image_url:f?.image_override||i.image_url||i.image,featured:featuredIds.has(String(i.id))||!!i.featured,discount_price:i.discount_price??null,category_name:i.category_name||i.category,variants:(i.variants||[]).map(v=>({id:v.id,name:v.name,price:Number(v.price_delta||v.price||0)})),addons:(i.addons||[]).map(a=>({id:a.id,name:a.name,price:Number(a.price||a.price_delta||0)}))}});
   setItems(menu);setCategories(rawCategories.map((x,i)=>({id:String(x.id||i),name:x.name||x.category_name||'Menu',description:x.description||'',image_url:x.image_url||''})));setOffers(rawOffers.map(o=>({id:o.id,code:String(o.code||o.id).toUpperCase(),title:o.title,discount_type:o.discount_type==='percent'?'percent':'amount',discount_value:o.discount_type==='percent'?o.discount:Number(o.discount||0),min_order_amount:Number(o.min_order_amount??o.min_order??0)})));setFeatured(snapshot.featured?.length?snapshot.featured:featuredRows);setBanners([...(snapshot.banners||[]),...(globalBanners||[]),...(localBanners||[])]);if(membershipData.store_config?.delivery===false)setMode('pickup');
   if(!live?.ok && !membershipData.listing_override?.title) setMsg('');
  }catch(e){setMsg(e.message)}finally{setLoading(false)}})()},[id]);
 const listing=r?.listing_override||{};const sc=r?.store_config||{};const cfg={...global,...sc};const pc=sc.page_content||{};const whyChoose=Array.isArray(pc.why_choose)?pc.why_choose:[];const howWorks=Array.isArray(pc.how_it_works)?pc.how_it_works:[];const testimonials=Array.isArray(sc.testimonials)?sc.testimonials:(Array.isArray(pc.testimonials)?pc.testimonials:[]);const appPromo=pc.app_promo||{};const flavorBanner=pc.flavor_banner||{};const reservation=pc.reservation||{};const footer=pc.footer||{};
 const effective={...global,...sc,logo_url:listing.logo_url||r?.logo||'',cover_url:listing.cover_url||r?.cover_image||global.restaurant_home_hero_image,gallery:Array.isArray(listing.gallery)?listing.gallery:[],title:listing.title||r?.name||'Restaurant',description:listing.description||'',tagline:listing.tagline||'',city:listing.city||r?.city||'',address:listing.address||r?.address||'',phone:listing.phone||r?.phone||'',website:listing.website||r?.website||'',whatsapp:listing.whatsapp||'',social_instagram:listing.social_instagram||'',social_facebook:listing.social_facebook||'',social_whatsapp:listing.social_whatsapp||''};
 const hero=effective.cover_url;const logo=effective.logo_url||'/assets/anaira-logo.webp';const accent=cfg.accent_color||global.restaurant_home_accent_color;const primary=global.restaurant_home_primary_color||'#073b2b';const background=cfg.store_background||global.restaurant_home_background_color||'#f7f7f5';const radius=Number(cfg.card_radius||global.restaurant_home_card_radius||20);const title=effective.title;const tagline=effective.tagline||r?.cuisine||'Fresh food • Direct ordering';const catalogLabel=membership?.catalog_source==='restaurant_saas'?'Restaurant SaaS + Store overrides':(membership?.catalog_source==='anaira_pos'?'ANAIRA POS + Store overrides':'ANAIRA Store catalog');const location=effective.city||effective.address||'India';
 const visible=useMemo(()=>items.filter(i=>(category==='all'||i.category_name===category)&&(!q||`${i.item_name} ${i.description||''}`.toLowerCase().includes(q.toLowerCase()))),[items,category,q]);
 const subtotal=cart.reduce((s,i)=>s+Number(i.unit_price||0)*i.quantity,0);const discount=useMemo(()=>{const o=offers.find(x=>x.code===coupon.trim().toUpperCase()&&subtotal>=x.min_order_amount);if(!o)return 0;return o.discount_type==='percent'?Math.min(subtotal,subtotal*o.discount_value/100):Math.min(subtotal,o.discount_value)},[coupon,offers,subtotal]);const deliveryFee=mode==='delivery'?Number(settings?.delivery_fee??sc.delivery_fee??0):0;const tax=Math.max(0,subtotal-discount)*Number(settings?.tax_percent??sc.tax_percent??0)/100;const total=Math.max(0,subtotal-discount)+deliveryFee+tax;
 function openItem(i){setSelected(i);setVariants(i.variants||[]);setAddons(i.addons||[]);setChosenVariant(null);setChosenAddons([])}
 useEffect(()=>{const dish=searchParams.get('dish');if(dish&&items.length){const i=items.find(x=>String(x.id)===String(dish));if(i)openItem(i)}},[items,searchParams]);
 useEffect(()=>{if(banners.length<2)return;const t=setInterval(()=>setHeroIndex(i=>(i+1)%banners.length),5200);return()=>clearInterval(t)},[banners.length]);
 function addSelected(){if(!selected)return;const unit=Number(selected.discount_price??selected.price)+Number(chosenVariant?.price||0)+chosenAddons.reduce((s,a)=>s+Number(a.price||0),0);const key=`${selected.id}:${chosenVariant?.id||'base'}:${chosenAddons.map(x=>x.id).sort().join(',')}`;setCart(c=>{const found=c.find(x=>x.key===key);return found?c.map(x=>x.key===key?{...x,quantity:x.quantity+1}:x):[...c,{key,name:selected.item_name,menu_item_id:selected.id,quantity:1,unit_price:unit,modifiers:{variant:chosenVariant?{id:chosenVariant.id,name:chosenVariant.name,price:chosenVariant.price}:null,addons:chosenAddons.map(a=>({id:a.id,name:a.name,price:a.price}))}}]});setSelected(null)}
 function updateQty(k,d){setCart(c=>c.map(x=>x.key===k?{...x,quantity:x.quantity+d}:x).filter(x=>x.quantity>0))}
 async function checkout(){if(!cart.length||!form.name||!form.phone){setMsg('Name, phone and at least one item are required.');return}setBusy(true);const response=await fetch(`/api/marketplace/restaurant/${r.id}/order`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({client_request_id:globalThis.crypto.randomUUID(),customer:{name:form.name,phone:form.phone},address:{text:form.address,type:mode,coupon:coupon||null,delivery_fee:deliveryFee,tax,discount},items:cart.map(i=>({menu_item_id:i.menu_item_id,quantity:i.quantity,modifiers:i.modifiers})),offer_id:null})});const data=await response.json();setBusy(false);if(!response.ok||!data.ok)setMsg(data.error||'Unable to place order');else{setMsg(`Order ${data.order?.order_id||''} received by the restaurant.`);setCart([]);setCoupon('')}}
 if(loading)return <main className="restaurant-store-v9"><div className="store-loading">Loading restaurant experience…</div></main>;if(!r)return <main className="restaurant-store-v9"><div className="store-loading">{msg||'Restaurant unavailable.'}</div></main>;
 const modes=[['delivery','Delivery'],['pickup','Pickup'],['dine_in','Dine-in']].filter(([m])=>sc[m]!==false);
 const handleFeatureClick=(f)=>{const type=f?.action_type||'menu';const value=String(f?.action_value||'').trim();if(type==='item'&&value){const found=items.find(i=>String(i.id)===value);if(found){openItem(found);return}}if(type==='category'&&value){setCategory(value);document.getElementById('menu')?.scrollIntoView({behavior:'smooth',block:'start'});return}if(type==='offers'){document.getElementById('offers')?.scrollIntoView({behavior:'smooth',block:'center'});return}if(type==='gallery'){document.getElementById('gallery')?.scrollIntoView({behavior:'smooth',block:'center'});return}if(type==='about'){document.getElementById('about')?.scrollIntoView({behavior:'smooth',block:'start'});return}if(type==='reservation'){document.getElementById('reservation')?.scrollIntoView({behavior:'smooth',block:'center'});return}if(type==='url'&&value){window.location.href=value;return}document.getElementById('menu')?.scrollIntoView({behavior:'smooth',block:'start'});};
const globalBannerVisible=global.restaurant_home_show_banners!==false;const showPopular=cfg.show_popular!==false&&global.restaurant_home_show_popular!==false;const showOffers=cfg.show_offers!==false&&global.restaurant_home_show_offers!==false;const showGallery=cfg.show_gallery!==false;const showFooter=cfg.show_footer!==false&&global.restaurant_home_show_footer!==false;
 return <main className="restaurant-store-v9" style={{'--bg':background,'--surface':global.restaurant_home_surface_color||'#fff','--text':global.restaurant_home_text_color||'#17352a','--primary':primary,'--accent':accent,'--radius':`${radius}px`}}>
  <header className="v9-top"><div className="v9-brand"><img src={logo} alt=""/><div><b>{title}</b><small>ANAIRA RESTAURANT STORE</small></div></div><nav><a href="#menu">Menu</a><a href="#offers">Offers</a><a href="#about">About</a></nav><div className="v9-actions"><a href={`tel:${effective.phone||''}`}>Call</a><a href="#cart">Cart · {cart.reduce((s,x)=>s+x.quantity,0)}</a></div></header>
  <section className="v9-hero" style={{backgroundImage:(banners[heroIndex]?.image_url||hero)?`linear-gradient(90deg,rgba(5,24,17,.86),rgba(5,24,17,.16)),url(${banners[heroIndex]?.image_url||hero})`:`linear-gradient(115deg,${primary},#14563e)`}}><div className="v9-hero-content"><span className="eyebrow">ANAIRA · VERIFIED RESTAURANT</span><h1>{banners[heroIndex]?.title||title}</h1><p>{banners[heroIndex]?.subtitle||effective.description||tagline}</p><div className="v9-meta"><span>📍 {location}</span><span>🍽 {r.cuisine||'Restaurant'}</span><span>● Live menu</span></div><div className="v9-hero-buttons"><a href={banners[heroIndex]?.cta_url||cfg.hero_cta_url||'#menu'} className="v9-gold-btn">{banners[heroIndex]?.cta_label||cfg.hero_cta_label||'Order Now'} →</a><a href="#menu" className="v9-ghost-btn">Explore Menu</a></div></div><div className="v9-hero-card"><div className="v9-status"><i/> OPEN FOR ORDERS</div><strong>{settings?.timings?.open||'09:00'} – {settings?.timings?.close||'23:00'}</strong><span>{modes.map(x=>x[1]).join(' · ')}</span>{banners.length>1&&<div className="v9-hero-controls"><button onClick={()=>setHeroIndex(i=>(i-1+banners.length)%banners.length)}>‹</button><small>{heroIndex+1} / {banners.length}</small><button onClick={()=>setHeroIndex(i=>(i+1)%banners.length)}>›</button></div>}</div></section>
  {Array.isArray(sc.feature_icons)&&sc.feature_icons.length>0&&<section className="v9-feature-icons">{sc.feature_icons.slice(0,8).map((f,i)=><button type="button" key={i} onClick={()=>handleFeatureClick(f)}><div>{f.icon||'✦'}</div><b>{f.title}</b><small>{f.text}</small><span>Explore ↗</span></button>)}</section>}
  <section className="v9-trust"><div><b>LIVE CATALOG</b><span>Restaurant SaaS menu</span></div><div><b>{items.length}+</b><span>Dishes available</span></div><div><b>{categories.length}</b><span>Categories</span></div><div><b>DIRECT</b><span>Order to restaurant</span></div></section>{whyChoose.length>0&&<section className="v9-section v9-why" id="why"><div className="v9-heading center"><div><span>{pc.why_label||'WHY CHOOSE US'}</span><h2>{pc.why_title||'A better food experience for everyone'}</h2></div></div><div className="v9-why-grid">{whyChoose.slice(0,8).map((x,i)=><button type="button" key={i} onClick={()=>handleFeatureClick(x)}><b>{x.icon||'✦'}</b><strong>{x.title}</strong><small>{x.text||x.description||''}</small></button>)}</div></section>}
  <main className="v9-container">
   {cfg.show_announcement!==false&&cfg.announcement&&<div className="v9-announcement">✦ {cfg.announcement}</div>}

   {showPopular&&featured.length>0&&<section className="v9-section" id="popular"><div className="v9-heading"><div><span>OUR SPECIALTIES</span><h2>{sc.popular_title||`Popular Dishes`}</h2></div><a className="v9-section-link" href="#menu">View Full Menu →</a></div><div className="v9-featured-grid">{featured.slice(0,8).map(f=>{const i=items.find(x=>String(x.id)===String(f.external_item_id));return i?<article key={f.id} className="v9-featured v9-clickable" onClick={()=>openItem(i)}><div>{f.image_override||i.image_url?<img src={f.image_override||i.image_url} alt={i.item_name}/>:<div className="v9-noimg">🍽</div>}<b>{f.badge||'POPULAR'}</b><button type="button" aria-label={`Open ${i.item_name}`}>↗</button></div><h3>{f.title_override||i.item_name}</h3><p>{i.description||i.category_name||'Restaurant special'}</p><span>₹{i.discount_price??i.price}</span></article>:null})}</div></section>}

   {cfg.show_categories!==false&&categories.length>0&&<section className="v9-category-band" id="categories"><div className="v9-heading"><div><span>EXPLORE OUR</span><h2>{sc.category_title||'Menu Categories'}</h2></div><small>{sc.category_subtitle||'Explore dishes from our kitchen'}</small></div><div className="v9-category-strip"><button className={category==='all'?'active':''} onClick={()=>{setCategory('all');document.getElementById('menu')?.scrollIntoView({behavior:'smooth'})}}><span className="v9-cat-icon">🍽️</span><b>All</b><small>Explore dishes</small></button>{categories.slice(0,12).map(c=><button key={c.id} className={category===c.name?'active':''} onClick={()=>{setCategory(c.name);document.getElementById('menu')?.scrollIntoView({behavior:'smooth'})}}>{c.image_url?<img src={c.image_url} alt={c.name}/>:<span className="v9-cat-icon">🍴</span>}<b>{c.name}</b><small>{c.description||'Explore dishes'}</small></button>)}</div></section>}

   <section className="v9-section v9-about-premium" id="about"><div className="v9-heading"><div><span>ABOUT US</span><h2>{sc.about_title||title}</h2></div><small>{sc.about_subtitle||tagline}</small></div><div className="v9-about-grid"><div>{effective.gallery?.[0]&&<img src={effective.gallery[0]} alt={title}/>}</div><div><p>{effective.description||'A welcoming restaurant experience with fresh food, authentic flavours and direct ordering through Anaira.'}</p><p>{sc.about_text||''}</p><div className="v9-about-icons">{(Array.isArray(sc.feature_icons)?sc.feature_icons:[]).slice(0,4).map((f,i)=><button type="button" key={i} onClick={()=>handleFeatureClick(f)}><b>{f.icon||'✦'}</b><strong>{f.title||'Great Experience'}</strong><small>{f.text||''}</small></button>)}</div></div><div className="v9-contact-card"><b>Contact & Location</b><span>📍 {effective.address||location}</span><span>☎ {effective.phone||'Contact restaurant'}</span><span>🕒 {settings?.timings?.open||'09:00'} – {settings?.timings?.close||'23:00'}</span>{effective.website&&<a href={effective.website}>Website ↗</a>}<a href={`tel:${effective.phone||''}`}>Call Restaurant</a></div></div></section>

   {flavorBanner.image_url&&<section className="v9-flavor" style={{backgroundImage:`linear-gradient(90deg,rgba(7,29,21,.9),rgba(7,29,21,.25)),url(${flavorBanner.image_url})`}}><div><span>{flavorBanner.eyebrow||'DISCOVER OUR FLAVOURS'}</span><h2>{flavorBanner.title||'Taste the flavours of our kitchen'}</h2><p>{flavorBanner.text||'Authentic food, warm hospitality and memorable dining.'}</p>{flavorBanner.cta_label&&<a href={flavorBanner.cta_url||'#menu'} className="v9-gold-btn">{flavorBanner.cta_label} →</a>}</div></section>}

{showGallery&&Array.isArray(effective.gallery)&&effective.gallery.length>0&&<section className="v9-section" id="gallery"><div className="v9-heading"><div><span>OUR RESTAURANT GALLERY</span><h2>{cfg.gallery_title||'Our Restaurant Gallery'}</h2></div><small>{cfg.gallery_subtitle||'A glimpse inside the restaurant'}</small></div><div className="v9-gallery-premium">{effective.gallery.slice(0,12).map((u,i)=><button type="button" key={`${u}-${i}`} onClick={()=>window.open(u,'_blank')}><img src={u} alt={`${title} ${i+1}`}/><span>View photo ↗</span></button>)}</div></section>}

   {showOffers&&offers.length>0&&<section className="v9-offer-hero" id="offers"><div><span>SPECIAL OFFER</span><h2>{sc.offer_title||'Delicious Food, Special Moments'}</h2><p>{sc.offer_text||offers[0]?.title||'Enjoy special offers from this restaurant.'}</p><button type="button" onClick={()=>document.getElementById('menu')?.scrollIntoView({behavior:'smooth'})}>{sc.offer_cta||'Order Now'} →</button></div><div className="v9-offer-badge">{offers[0].discount_type==='percent'?`${offers[0].discount_value}% OFF`:`₹${offers[0].discount_value} OFF`}</div></section>}

   {Array.isArray(sc.testimonials)&&sc.testimonials.length>0&&<section className="v9-section" id="reviews"><div className="v9-heading"><div><span>WHAT OUR CUSTOMERS SAY</span><h2>{sc.reviews_title||'Customer Reviews'}</h2></div><small>{sc.reviews_subtitle||'Real feedback from our guests'}</small></div><div className="v9-testimonials">{sc.testimonials.slice(0,6).map((t,i)=><article key={i}><div>★★★★★</div><p>“{t.text||''}”</p><b>{t.name||'Guest'}</b>{t.meta&&<small>{t.meta}</small>}</article>)}</div></section>}

   <section className="v9-reservation" id="reservation"><div><span>BOOK A TABLE</span><h2>{reservation.title||sc.reservation_title||'Plan Your Visit'}</h2><p>{reservation.text||sc.reservation_text||'Reserve your table for a delightful dining experience.'}</p></div><div className="v9-reservation-card"><input placeholder="Your Name"/><input placeholder="Phone Number"/><input type="date"/><input type="number" min="1" placeholder="Number of People"/><button type="button" onClick={()=>setMsg('Reservation request ready — connect your restaurant reservation workflow to confirm the booking.')}>{reservation.cta_label||sc.reservation_cta||'Book Now'} →</button></div></section>

   <section className="v9-section" id="menu"><div className="v9-heading"><div><span>LIVE MENU</span><h2>{sc.menu_title||'Order from our kitchen'}</h2></div><small>{items.length} items · {catalogLabel}</small></div><div className="v9-toolbar">{global.restaurant_home_show_search!==false&&<input value={q} onChange={e=>setQ(e.target.value)} placeholder="Search dishes…"/>}<div className="v9-cats"><button className={category==='all'?'active':''} onClick={()=>setCategory('all')}>All</button>{categories.map(c=><button key={c.id} className={category===c.name?'active':''} onClick={()=>setCategory(c.name)}>{c.name}</button>)}</div></div>{showOffers&&offers.length>0&&<div className="v9-offers">{offers.map(o=><div key={o.id}><b>{o.code}</b><span>{o.title}</span><strong>{o.discount_type==='percent'?`${o.discount_value}% OFF`:`₹${o.discount_value} OFF`}</strong></div>)}</div>}<div className="v9-menu-grid">{visible.map(i=><article key={i.id} className="v9-food" onClick={()=>openItem(i)}><div className="v9-food-img">{i.image_url?<img src={i.image_url} alt=""/>:<div className="v9-noimg">🍽</div>}{i.featured&&<b>FEATURED</b>}</div><div className="v9-food-body"><div><span>{i.category_name||'Menu'}</span><h3>{i.item_name}</h3></div><p>{i.description||'Freshly prepared from the restaurant kitchen.'}</p><div className="v9-price"><strong>₹{i.discount_price??i.price}</strong>{i.discount_price!=null&&<del>₹{i.price}</del>}<button type="button" onClick={(e)=>{e.stopPropagation();openItem(i)}}>Add +</button></div></div></article>)}</div>{!visible.length&&<div className="store-empty">No dishes found.</div>}</section>
  </main>
  {cfg.show_cart!==false&&<aside className="v9-cart" id="cart"><div className="v9-cart-head"><div><span>YOUR ORDER</span><h2>Cart</h2></div><b>{cart.reduce((s,x)=>s+x.quantity,0)} items</b></div><div className="v9-modes">{modes.map(([v,l])=><button key={v} className={mode===v?'active':''} onClick={()=>setMode(v)}>{l}</button>)}</div><div className="v9-cart-lines">{cart.length?cart.map(i=><div className="v9-cart-line" key={i.key}><div><b>{i.name}</b><small>{i.modifiers?.variant?.name||''}{i.modifiers?.addons?.length?` · ${i.modifiers.addons.map(a=>a.name).join(', ')}`:''}</small><span>₹{i.unit_price}</span></div><div><button onClick={()=>updateQty(i.key,-1)}>−</button><b>{i.quantity}</b><button onClick={()=>updateQty(i.key,1)}>+</button></div></div>):<p>Your cart is empty. Add a dish to begin.</p>}</div><div className="v9-checkout"><div className="v9-coupon"><input value={coupon} onChange={e=>setCoupon(e.target.value)} placeholder="Coupon code"/><button onClick={()=>setMsg(offers.some(o=>o.code===coupon.trim().toUpperCase())?'Coupon ready to apply.':'Coupon not found.')}>Apply</button></div><div className="v9-totals"><span>Subtotal <b>₹{Math.round(subtotal)}</b></span><span>Discount <b>−₹{Math.round(discount)}</b></span><span>Delivery <b>₹{Math.round(deliveryFee)}</b></span><span>Tax <b>₹{Math.round(tax)}</b></span><strong>Total <b>₹{Math.round(total)}</b></strong></div><input placeholder="Full name" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/><input placeholder="Mobile number" value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})}/><textarea placeholder={mode==='delivery'?'Delivery address':'Table / pickup note'} value={form.address} onChange={e=>setForm({...form,address:e.target.value})}/><button className="v9-place" disabled={busy||!cart.length} onClick={checkout}>{busy?'Placing…':'Place Order · ₹'+Math.round(total)}</button>{msg&&<p className="v9-msg">{msg}</p>}</div></aside>}
  {showFooter&&<footer className="v9-footer"><div><img src={logo} alt=""/><div><b>{title}</b><span>{location}</span></div></div><div><span>{footer.text||global.restaurant_home_footer_text}</span><span>📍 {effective.address||location}</span><span>☎ {effective.phone||'Contact restaurant'}</span>{effective.social_instagram&&<a href={effective.social_instagram}>Instagram</a>}{effective.social_facebook&&<a href={effective.social_facebook}>Facebook</a>}{effective.social_whatsapp&&<a href={effective.social_whatsapp}>WhatsApp</a>}</div></footer>}
  {selected&&<div className="v9-modal-bg" onClick={()=>setSelected(null)}><div className="v9-modal" onClick={e=>e.stopPropagation()}><button onClick={()=>setSelected(null)}>×</button><h2>{selected.item_name}</h2><p>{selected.description}</p><h3>₹{selected.discount_price??selected.price}</h3>{variants.length>0&&<><h4>Choose a variant</h4>{variants.map(v=><label key={v.id}><input type="radio" name="v" checked={chosenVariant?.id===v.id} onChange={()=>setChosenVariant(v)}/><span>{v.name}</span><b>+₹{v.price}</b></label>)}</>}{addons.length>0&&<><h4>Add-ons</h4>{addons.map(a=><label key={a.id}><input type="checkbox" checked={chosenAddons.some(x=>x.id===a.id)} onChange={e=>setChosenAddons(c=>e.target.checked?[...c,a]:c.filter(x=>x.id!==a.id))}/><span>{a.name}</span><b>+₹{a.price}</b></label>)}</>}<button className="v9-place" onClick={addSelected}>Add to Cart</button></div></div>}
  <style jsx global>{`
   .v9-clickable{cursor:pointer}.v9-section-link{display:inline-flex;align-items:center;color:#9b762d;font-weight:800;text-decoration:none;border:1px solid #d9bf85;border-radius:999px;padding:10px 16px;background:#fffaf0}.v9-featured>div{position:relative}.v9-featured>div>button{position:absolute;right:10px;bottom:10px;border:1px solid #fff;background:#073b2bdd;color:#fff;border-radius:999px;width:34px;height:34px;cursor:pointer}.v9-featured p{margin:5px 0;color:#777;font-size:12px;min-height:30px}.v9-featured span{font-weight:900;color:#17352a}.v9-category-band{margin:0 calc(50% - 50vw);padding:44px max(24px,calc((100vw - 1240px)/2));background:#fff;border-top:1px solid #e7dfd2;border-bottom:1px solid #e7dfd2}.v9-category-strip{display:grid;grid-template-columns:repeat(10,minmax(90px,1fr));gap:0;margin-top:24px;background:#fff}.v9-category-strip button{min-height:125px;border:0;border-right:1px solid #eadfce;background:#fff;display:grid;place-items:center;align-content:center;gap:7px;padding:12px 8px;cursor:pointer;color:#17352a;transition:.2s}.v9-category-strip button:first-child{border-left:1px solid #eadfce}.v9-category-strip button:hover,.v9-category-strip button.active{background:#fffaf0;box-shadow:inset 0 -3px #d5aa4b}.v9-category-strip img,.v9-cat-icon{width:58px;height:58px;border-radius:50%;object-fit:cover;border:1px solid #d6ad56;background:#fff8e8;display:grid;place-items:center;font-size:27px}.v9-category-strip b{font-size:12px}.v9-category-strip small{font-size:9px;color:#888}.v9-about-icons{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px}.v9-about-icons button{border:0;background:transparent;cursor:pointer;text-align:center;padding:8px}.v9-about-icons b{width:46px;height:46px;margin:auto;display:grid;place-items:center;border:1px solid #d8ae56;border-radius:50%;background:#fff7e4;font-size:21px}.v9-about-icons strong,.v9-about-icons small{display:block}.v9-about-icons strong{font-size:10px;margin-top:6px}.v9-about-icons small{font-size:9px;color:#777;margin-top:3px}.v9-gallery-premium{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.v9-gallery-premium button{position:relative;border:0;padding:0;border-radius:16px;overflow:hidden;cursor:pointer;background:#ddd;min-height:180px}.v9-gallery-premium img{width:100%;height:220px;object-fit:cover;display:block;transition:.35s}.v9-gallery-premium button:hover img{transform:scale(1.04)}.v9-gallery-premium span{position:absolute;left:12px;bottom:12px;padding:7px 10px;border-radius:999px;background:#073b2bdd;color:#fff;font-size:10px}.v9-offer-hero{margin:24px 0;padding:42px 48px;border-radius:22px;background:linear-gradient(100deg,#8b1215,#5b090d);color:#fff;display:flex;justify-content:space-between;align-items:center;overflow:hidden;box-shadow:0 18px 45px #5b090d25}.v9-offer-hero span{font-size:10px;letter-spacing:2px;color:#e8c45f;font-weight:900}.v9-offer-hero h2{font-family:Georgia,serif;font-size:34px;margin:8px 0}.v9-offer-hero p{max-width:560px;color:#f6e7e1}.v9-offer-hero button{border:0;background:#e9b83e;color:#3d2500;border-radius:999px;padding:12px 20px;font-weight:900;cursor:pointer}.v9-offer-badge{width:110px;height:110px;border-radius:50%;border:2px solid #f1ce73;display:grid;place-items:center;text-align:center;font-weight:900;font-size:18px;transform:rotate(8deg)}.v9-testimonials{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.v9-testimonials article{background:#fff;border:1px solid #e7dfd4;border-radius:16px;padding:20px;box-shadow:0 8px 28px #17352a08}.v9-testimonials article>div{color:#e9ad24;letter-spacing:2px}.v9-testimonials p{font-size:14px;line-height:1.6;color:#59615c;min-height:55px}.v9-testimonials b,.v9-testimonials small{display:block}.v9-testimonials small{color:#888;margin-top:4px}.v9-reservation{margin:24px 0;padding:32px;border-radius:20px;background:linear-gradient(100deg,#15120ecc,#15120e55),linear-gradient(120deg,#4a2b16,#1e3427);color:#fff;display:grid;grid-template-columns:1fr 1.1fr;gap:28px;align-items:center}.v9-reservation>div:first-child span{color:#e9c45d;font-size:10px;letter-spacing:2px;font-weight:900}.v9-reservation h2{font-family:Georgia,serif;font-size:34px;margin:8px 0}.v9-reservation p{color:#e8e5df}.v9-reservation-card{background:#fff;border-radius:16px;padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.v9-reservation-card input{border:1px solid #ddd7cc;border-radius:10px;padding:12px;min-width:0}.v9-reservation-card button{grid-column:1/-1;border:0;border-radius:10px;background:#eab63f;color:#3d2700;padding:13px;font-weight:900;cursor:pointer}.v9-feature-icons button{border:0;border-right:1px solid #ffffff55;background:transparent;color:#fff;cursor:pointer;padding:20px 12px;display:grid;place-items:center;gap:5px}.v9-feature-icons button:hover{background:#ffffff10}.v9-feature-icons button span{font-size:9px;color:#e4c46f;margin-top:3px}.sb-feature-rich{display:grid!important;grid-template-columns:45px 1fr 1.3fr 150px 1fr auto!important;gap:8px;align-items:center}.sb-json-area{min-height:180px;font-family:ui-monospace,monospace}.v9-heading.center{justify-content:center;text-align:center}.v9-why{padding-top:8px}.v9-why-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.v9-why-grid button{border:0;background:transparent;text-align:center;cursor:pointer;padding:10px}.v9-why-grid b{width:58px;height:58px;border-radius:50%;border:1px solid #d8ae56;background:#fff7e4;display:grid;place-items:center;margin:auto;font-size:24px}.v9-why-grid strong,.v9-why-grid small{display:block}.v9-why-grid strong{margin-top:8px;font-size:12px}.v9-why-grid small{margin-top:4px;color:#777;font-size:10px;line-height:1.4}.v9-flavor,.v9-app-promo{margin:24px 0;border-radius:20px;min-height:260px;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:space-between;padding:42px 54px;color:#fff;overflow:hidden}.v9-flavor>div,.v9-app-promo>div:first-child{max-width:650px}.v9-flavor span,.v9-app-promo span{font-size:10px;letter-spacing:2px;color:#efca63;font-weight:900}.v9-flavor h2,.v9-app-promo h2{font-family:Georgia,serif;font-size:38px;margin:8px 0}.v9-flavor p,.v9-app-promo p{color:#f2eee7;max-width:600px}.v9-how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.v9-how-grid>div{text-align:center;position:relative;padding:20px}.v9-how-grid>div:not(:last-child)::after{content:'→';position:absolute;right:-12px;top:32px;color:#b89b69;font-size:22px}.v9-how-grid b{width:56px;height:56px;border-radius:50%;border:1px solid #d8ae56;background:#fff7e4;display:grid;place-items:center;margin:auto;color:#8b691f}.v9-how-grid strong,.v9-how-grid small{display:block}.v9-how-grid strong{margin-top:10px}.v9-how-grid small{margin-top:5px;color:#777}.v9-app-points{display:grid;gap:12px;min-width:250px}.v9-app-points span{display:flex;align-items:center;gap:10px;color:#fff;letter-spacing:0}.v9-app-points b{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#e8bb46;color:#4b3000}@media(max-width:900px){.v9-why-grid{grid-template-columns:repeat(3,1fr)}.v9-how-grid{grid-template-columns:repeat(2,1fr)}.v9-how-grid>div:not(:last-child)::after{display:none}.v9-flavor,.v9-app-promo{padding:30px;display:block}.v9-app-points{margin-top:20px}}@media(max-width:600px){.v9-why-grid{grid-template-columns:repeat(2,1fr)}.v9-how-grid{grid-template-columns:1fr}.v9-flavor h2,.v9-app-promo h2{font-size:30px}}@media(max-width:900px){.v9-category-strip{grid-template-columns:repeat(5,1fr)}.v9-gallery-premium{grid-template-columns:repeat(2,1fr)}.v9-testimonials{grid-template-columns:1fr}.v9-reservation{grid-template-columns:1fr}.v9-about-icons{grid-template-columns:repeat(2,1fr)}.v9-offer-hero{padding:30px}.sb-feature-rich{grid-template-columns:45px 1fr!important}.sb-feature-rich select,.sb-feature-rich input:nth-of-type(2),.sb-feature-rich button{grid-column:1/-1}}@media(max-width:600px){.v9-category-strip{grid-template-columns:repeat(2,1fr)}.v9-gallery-premium{grid-template-columns:1fr}.v9-reservation-card{grid-template-columns:1fr}.v9-reservation-card button{grid-column:1}.v9-offer-badge{display:none}}
  `}</style>

 </main>
}
