'use client';
import {Suspense,useEffect,useMemo,useState} from 'react';
import {useRouter,useSearchParams} from 'next/navigation';
import {AppShell,Header,Section,Kpi,Pill} from '../components';
import {supabase} from '../../lib/supabase';
import MediaPicker from '../../components/anaira/MediaPicker';
import MarketplaceQR from '../../components/anaira/MarketplaceQR';

const blankItem={id:null,item_name:'',category_id:'',category_name:'',description:'',price:'',discount_price:'',image_url:'',veg_type:'veg',tags:'',prep_time_minutes:'',tax_percent:'',featured:false,active:true};
const blankCategory={id:null,name:'',description:'',image_url:'',display_order:0,active:true};
const blankOption={name:'',price:''};
const sourceLabels={anaira_pos:'ANAIRA POS',anaira_hms:'ANAIRA HMS / PMS',external_integration:'External Software',manual:'Manual Catalog'};
const Field=({label,children,wide=false})=><label style={{display:'grid',gap:6,fontSize:12,fontWeight:700,gridColumn:wide?'1/-1':undefined}}><span>{label}</span>{children}</label>;


function UploadField({label,value,onChange,restaurantId,folder,multiple=false}){
 return <MediaPicker value={value} multiple={multiple} restaurantId={restaurantId} folder={folder} label={label} onChange={onChange} hint="Upload directly or choose from ANAIRA Gallery"/>;
}

const tabItems=[
 ['overview','Overview','Store health & quick controls'],
 ['branding','Branding','Identity, hero & gallery'],
 ['homepage','Homepage','Banners, featured dishes & sections'],
 ['operations','Ordering','Delivery, pickup, hours & payments'],
 ['catalog','Catalog','Categories, menu items & modifiers'],
 ['offers','Offers','Coupons and promotions'],
 ['integrations','Integrations','Source, connections & sync'],
 ['seo','SEO & Publish','Search, sharing & publish']
];

function StoreTabNav({active,onChange}){
 return <div className="sb-tabs">{tabItems.map(([id,title,sub])=><button key={id} type="button" className={active===id?'active':''} onClick={()=>onChange(id)}><b>{title}</b><small>{sub}</small></button>)}</div>;
}

function StoreBuilder(){
 const router=useRouter(),searchParams=useSearchParams();
 const [session,setSession]=useState(undefined),[profile,setProfile]=useState(null),[property,setProperty]=useState(null),[rid,setRid]=useState(''),[kind,setKind]=useState('restaurant'),[availableKinds,setAvailableKinds]=useState(['restaurant']);
 const [store,setStore]=useState(null),[membership,setMembership]=useState(null),[settings,setSettings]=useState(null),[connections,setConnections]=useState([]),[activeHospitalityType,setActiveHospitalityType]=useState('hotel');
 const [form,setForm]=useState({title:'',tagline:'',description:'',logo_url:'',cover_url:'',gallery:[],phone:'',whatsapp:'',website:'',address:'',city:'',state:'',postal_code:'',delivery:true,pickup:true,dine_in:true,seo_title:'',seo_description:'',min_order_amount:0,delivery_fee:0,delivery_radius_km:'',tax_percent:0,payment_methods:'cod,pay_at_hotel',open_time:'09:00',close_time:'23:00',banner_title:'',banner_subtitle:'',banner_image_url:'',banner_mobile_image_url:'',banner_cta_label:'',banner_cta_url:'',theme_mode:'light',accent_color:'#0b6b4f',announcement:'',social_instagram:'',social_facebook:'',social_whatsapp:'',delivery_eta_minutes:45,service_fee:0,order_notes_enabled:true,show_popular:true,show_offers:true,show_gallery:true,show_reviews:false,hero_overlay:0.45,card_radius:20,store_background:'#f7f5ef',show_categories:true,show_search:true,show_cart:true,show_announcement:true,show_footer:true,hero_cta_label:'Order Now',hero_cta_url:'',gallery_title:'Our Restaurant Gallery',gallery_subtitle:'A glimpse inside the restaurant',about_title:'',about_subtitle:'',about_text:'',category_title:'Menu Categories',category_subtitle:'Explore dishes from our kitchen',popular_title:'Popular Dishes',offer_title:'Delicious Food, Special Moments',offer_text:'Enjoy special offers from this restaurant.',offer_cta:'Order Now',reservation_title:'Plan Your Visit',reservation_text:'Reserve your table for a delightful dining experience.',reservation_cta:'Book Now',reviews_title:'Customer Reviews',reviews_subtitle:'Real feedback from our guests',testimonials:[] ,menu_title:'Order from our kitchen'});
 const [categories,setCategories]=useState([]),[items,setItems]=useState([]),[homeBanners,setHomeBanners]=useState([]),[featuredItems,setFeaturedItems]=useState([]),[featureIcons,setFeatureIcons]=useState([{icon:'🍽️',title:'Fresh Food',text:'Quality food prepared with care'},{icon:'🚴',title:'Fast Delivery',text:'Hot & fresh to your doorstep'},{icon:'💳',title:'Secure Payments',text:'Multiple payment options'},{icon:'🎁',title:'Exclusive Offers',text:'Best deals for customers'}]),[liveMenu,setLiveMenu]=useState([]),[selectedItem,setSelectedItem]=useState(null),[variants,setVariants]=useState([]),[addons,setAddons]=useState([]),[newVariant,setNewVariant]=useState(blankOption),[newAddon,setNewAddon]=useState(blankOption);
 const [categoryForm,setCategoryForm]=useState(blankCategory),[itemForm,setItemForm]=useState(blankItem);
 const [orders,setOrders]=useState([]),[offers,setOffers]=useState([]),[hotelRoomTypes,setHotelRoomTypes]=useState([]),[hotelRatePlans,setHotelRatePlans]=useState([]),[hotelInventory,setHotelInventory]=useState([]),[hotelReservations,setHotelReservations]=useState([]),[newOffer,setNewOffer]=useState({code:'',title:'',description:'',discount_type:'percent',discount_value:'',min_order_amount:0,active:true});
 const [error,setError]=useState(''),[saved,setSaved]=useState(false),[busy,setBusy]=useState(false),[storeTab,setStoreTab]=useState('overview');

 useEffect(()=>{(async()=>{
   if(!supabase){setSession(null);return}
   const {data:{session}}=await supabase.auth.getSession();setSession(session);if(!session)return;
   const {data:p}=await supabase.from('anaira_my_profile').select('restaurant_id,is_super_admin,role,full_name').eq('id',session.user.id).maybeSingle();
   setProfile(p||{});
   if(p?.is_super_admin){router.replace('/super-admin/stores');return}
   if(p?.role!=='admin'){router.replace('/');return}
   if(!p?.restaurant_id)return;
   setRid(p.restaurant_id);
   const [{data:r},{data:pl}]=await Promise.all([
     supabase.from('restaurants').select('id,name,status,city,address,logo,cover_image,cuisine,phone,website,delivery_enabled,hospitality_type,hospitality_types').eq('id',p.restaurant_id).maybeSingle(),
     supabase.from('restaurant_plugins').select('plugin_code,enabled').eq('restaurant_id',p.restaurant_id)
   ]);
   setProperty(r||null);
   const enabled=new Set((pl||[]).filter(x=>x.enabled).map(x=>x.plugin_code));
   const kinds=[];
   if(enabled.has('restaurant-store')||enabled.has('anaira-pos')||enabled.has('food-delivery'))kinds.push('restaurant');
   const configured=Array.isArray(r?.hospitality_types)&&r.hospitality_types.length
     ? r.hospitality_types
     : (r?.hospitality_type?[r.hospitality_type]:[]);
   const hospitalityPlugin={hotel:'hotel-management-suite',camp:'camping-management',homestay:'homestay-management',guest_house:'guest-house-management',cottage:'cottage-management'};
   const hasExplicitHospitalitySelection=configured.length>0;
   let hospitality=[...new Set(configured.filter(t=>Object.prototype.hasOwnProperty.call(hospitalityPlugin,t)))];
   // Profile hospitality_types is authoritative. Never infer Hotel from legacy HMS rows
   // when the property is explicitly configured as Camping/Homestay/etc.
   if(!hasExplicitHospitalitySelection){
     const [{data:legacyCamp},{data:hmsTypes}]=await Promise.all([
       supabase.from('camp_unit_types').select('id').eq('restaurant_id',r.id).eq('active',true).limit(1),
       supabase.from('hms_room_types').select('hospitality_type').eq('restaurant_id',r.id).eq('active',true)
     ]);
     for(const row of (hmsTypes||[])){const t=row?.hospitality_type;if(Object.prototype.hasOwnProperty.call(hospitalityPlugin,t)&&!hospitality.includes(t))hospitality.push(t)}
     if((legacyCamp||[]).length&&!hospitality.includes('camp'))hospitality.push('camp');
   }
   for(const t of hospitality){
     // Explicit property selection wins over stale legacy plugin assignments.
     // Super Admin can still remove the property type from hospitality_types to
     // remove this store context entirely.
     kinds.push(t);
   }
   const safe=kinds.length?kinds:['restaurant'];setAvailableKinds(safe);
   const requestedType=searchParams.get('hospitality_type');
   const hospitalityKinds=safe.filter(x=>x!=='restaurant');
   const nextType=requestedType&&hospitalityKinds.includes(requestedType)?requestedType:(hospitalityKinds[0]||'hotel');
   // `kind` is the customer-facing context (hotel/camp/homestay/etc).
   // All non-restaurant hospitality contexts still use the single canonical
   // ANAIRA hospitality platform store underneath.
   const requestedKind=searchParams.get('kind');
   const nextKind=requestedKind==='restaurant'&&safe.includes('restaurant')
     ?'restaurant'
     :(hospitalityKinds.includes(requestedKind)?requestedKind:nextType);
   setKind(nextKind);setActiveHospitalityType(nextKind==='restaurant'?nextType:nextKind);
   if(typeof window!=='undefined'){
     const u=new URL(window.location.href);
     u.searchParams.set('kind',nextKind);
     if(nextKind!=='restaurant')u.searchParams.set('hospitality_type',nextKind);
     else u.searchParams.delete('hospitality_type');
     window.history.replaceState({},'',u.toString());
   }
 })()},[router,searchParams]);

 useEffect(()=>{if(rid&&kind)load()},[rid,kind,activeHospitalityType]);
 const storeKind=kind==='restaurant'?'restaurant':'hotel';
 async function load(){
   setError('');
   const {data:s,error:se}=await supabase.from('anaira_platform_stores').select('*').eq('store_type',storeKind).maybeSingle();
   if(se){setError(se.message);return} setStore(s||null); if(!s)return;
   const {data:m,error:me}=await supabase.from('anaira_store_memberships').select('*').eq('store_id',s.id).eq('restaurant_id',rid).maybeSingle();
   if(me){setError(me.message);return} setMembership(m||null);
   const {data:ss}=await supabase.from('anaira_store_settings').select('*').eq('store_id',s.id).eq('restaurant_id',rid).maybeSingle();
   setSettings(ss||null);
   setFeatureIcons(Array.isArray(m?.store_config?.feature_icons)?m.store_config.feature_icons:[{icon:'🍽️',title:'Fresh Food',text:'Quality food prepared with care',action_type:'menu',action_value:''},{icon:'🚴',title:'Fast Delivery',text:'Hot & fresh to your doorstep',action_type:'menu',action_value:''},{icon:'💳',title:'Secure Payments',text:'Multiple payment options',action_type:'menu',action_value:''},{icon:'🎁',title:'Exclusive Offers',text:'Best deals for customers',action_type:'offers',action_value:''}]);
   const o=m?.listing_override||{}, sc=m?.store_config||{}, timings=ss?.timings||{};
   setForm({
     title:o.title||property?.name||'',tagline:o.tagline||'',description:o.description||'',logo_url:o.logo_url||property?.logo||'',cover_url:o.cover_url||property?.cover_image||'',gallery:Array.isArray(o.gallery)?o.gallery:[],phone:o.phone||property?.phone||'',whatsapp:o.whatsapp||'',website:o.website||property?.website||'',address:o.address||property?.address||'',city:o.city||property?.city||'',state:o.state||'',postal_code:o.postal_code||'',delivery:sc.delivery!==false,pickup:sc.pickup!==false,dine_in:sc.dine_in!==false,
     seo_title:ss?.seo_title||o.seo_title||'',seo_description:ss?.seo_description||o.seo_description||'',min_order_amount:ss?.min_order_amount??sc.min_order_amount??0,delivery_fee:ss?.delivery_fee??sc.delivery_fee??0,delivery_radius_km:ss?.delivery_radius_km??sc.delivery_radius_km??'',tax_percent:ss?.tax_percent??sc.tax_percent??0,payment_methods:Array.isArray(ss?.payment_methods)?ss.payment_methods.join(','):ss?.payment_methods||'cod,pay_at_hotel',open_time:timings.open||'09:00',close_time:timings.close||'23:00',theme_mode:sc.theme_mode||'light',accent_color:sc.accent_color||'#0b6b4f',announcement:sc.announcement||'',social_instagram:sc.social_instagram||'',social_facebook:sc.social_facebook||'',social_whatsapp:sc.social_whatsapp||'',delivery_eta_minutes:sc.delivery_eta_minutes??45,service_fee:sc.service_fee??0,order_notes_enabled:sc.order_notes_enabled!==false,show_popular:sc.show_popular!==false,show_offers:sc.show_offers!==false,show_gallery:sc.show_gallery!==false,show_reviews:sc.show_reviews===true,hero_overlay:sc.hero_overlay??0.45,card_radius:sc.card_radius??20,store_background:sc.store_background||'#f7f5ef',show_categories:sc.show_categories!==false,show_search:sc.show_search!==false,show_cart:sc.show_cart!==false,show_announcement:sc.show_announcement!==false,show_footer:sc.show_footer!==false,hero_cta_label:sc.hero_cta_label||'Order Now',hero_cta_url:sc.hero_cta_url||'',gallery_title:sc.gallery_title||'Our Restaurant Gallery',gallery_subtitle:sc.gallery_subtitle||'A glimpse inside the restaurant',about_title:sc.about_title||'',about_subtitle:sc.about_subtitle||'',about_text:sc.about_text||'',category_title:sc.category_title||'Menu Categories',category_subtitle:sc.category_subtitle||'Explore dishes from our kitchen',popular_title:sc.popular_title||'Popular Dishes',offer_title:sc.offer_title||'Delicious Food, Special Moments',offer_text:sc.offer_text||'Enjoy special offers from this restaurant.',offer_cta:sc.offer_cta||'Order Now',reservation_title:sc.reservation_title||'Plan Your Visit',reservation_text:sc.reservation_text||'Reserve your table for a delightful dining experience.',reservation_cta:sc.reservation_cta||'Book Now',reviews_title:sc.reviews_title||'Customer Reviews',reviews_subtitle:sc.reviews_subtitle||'Real feedback from our guests',testimonials:Array.isArray(sc.testimonials)?sc.testimonials:[],menu_title:sc.menu_title||'Order from our kitchen',catalog_source:m?.catalog_source||(kind==='restaurant'?'anaira_pos':'anaira_hms'),integration_connection_id:m?.integration_connection_id||''
   });
   const {data:c}=await supabase.from('anaira_integration_connections_v2').select('id,name,provider,integration_type,status').eq('restaurant_id',rid).order('name');setConnections(c||[]);
   if(storeKind==='restaurant'){
     const [{data:cats},{data:mi},{data:os},{data:of}]=await Promise.all([
       supabase.from('anaira_store_categories').select('*').eq('restaurant_id',rid).order('display_order').order('name'),
       supabase.from('anaira_marketplace_menu_items').select('*').eq('restaurant_id',rid).order('display_order').order('category_name').order('item_name').limit(500),
       supabase.from('delivery_orders').select('id,order_code,status,total_amount,created_at,source').eq('restaurant_id',rid).order('created_at',{ascending:false}).limit(12),
       supabase.from('anaira_store_offers').select('*').eq('restaurant_id',rid).order('created_at',{ascending:false})
     ]);setCategories(cats||[]);setItems(mi||[]);setOrders(os||[]);setOffers(of||[]);
     const {data:hb}=await supabase.from('anaira_store_banners').select('*').eq('store_id',s.id).eq('restaurant_id',rid).order('display_order'); setHomeBanners(hb||[]); const {data:fi}=await supabase.from('anaira_marketplace_featured_items').select('*').eq('store_id',s.id).eq('restaurant_id',rid).order('display_order'); setFeaturedItems(fi||[]); try { if(m?.catalog_source==='restaurant_saas'){ const lr=await fetch('/api/marketplace/restaurant/'+rid,{cache:'no-store'}); const lj=await lr.json(); setLiveMenu(lj?.ok?(lj.data?.menu||[]):[]); } else setLiveMenu(mi||[]); } catch { setLiveMenu(mi||[]); }
   }else{
     const [{data:rt},{data:rp},{data:inv},{data:rs}]=await Promise.all([
       supabase.from('hms_room_types').select('id,name,code,short_description,description,base_rate,max_adults,max_children,max_guests,hospitality_type,active,image_urls,amenities').eq('restaurant_id',rid).eq('hospitality_type',activeHospitalityType).order('name'),
       supabase.from('hms_rate_plans').select('id,name,code,room_type_id,board_type,rate,weekend_rate,seasonal_multiplier,active,refundable,deposit_percent,pricing_mode').eq('restaurant_id',rid).eq('hospitality_type',activeHospitalityType).order('name'),
       supabase.from('hms_inventory').select('id,room_type_id,stay_date,total_rooms,sold_rooms,blocked_rooms,closed').eq('restaurant_id',rid).order('stay_date').limit(180),
       supabase.from('hms_reservations').select('id,reservation_code,status,check_in,check_out,total_amount,created_at,room_type_id,rate_plan_id').eq('restaurant_id',rid).order('created_at',{ascending:false}).limit(12)
     ]);
     let finalRt=rt||[], finalRp=rp||[], finalInv=inv||[], finalRs=rs||[];

     // Camping compatibility: the property may already have real data in the
     // legacy camp_* tables while the canonical HMS tables are empty/partial.
     // Always read both sources for CAMPING, then map legacy unit/rate IDs to
     // the canonical HMS room IDs by code/name. This prevents an existing
     // camping property from appearing empty after the HMS unification.
     if(activeHospitalityType==='camp'){
       const [{data:legacyUnits},{data:legacyRates},{data:legacyInv},{data:legacyRes}]=await Promise.all([
         supabase.from('camp_unit_types').select('*').eq('restaurant_id',rid).eq('active',true).order('name'),
         supabase.from('camp_rate_plans').select('*').eq('restaurant_id',rid).eq('active',true).order('name'),
         supabase.from('camp_inventory').select('*').eq('restaurant_id',rid).order('stay_date').limit(180),
         supabase.from('camp_reservations').select('id,reservation_code,status,check_in,check_out,total_amount,created_at,unit_type_id,rate_plan_id').eq('restaurant_id',rid).order('created_at',{ascending:false}).limit(12)
       ]);
       const canonicalByKey=new Map(finalRt.map(x=>[`${String(x.code||'').trim().toLowerCase()}|${String(x.name||'').trim().toLowerCase()}`,x]));
       const unitMap=new Map();
       for(const u of (legacyUnits||[])){
         const key=`${String(u.code||'').trim().toLowerCase()}|${String(u.name||'').trim().toLowerCase()}`;
         let target=canonicalByKey.get(key);
         if(!target){
           target={...u,room_type_id:u.id,hospitality_type:'camp',short_description:u.description||'',max_guests:u.max_guests||u.max_adults||1,pricing_mode:'per_person'};
           finalRt.push(target);
           canonicalByKey.set(key,target);
         }
         unitMap.set(String(u.id),target);
       }
       const canonicalRateKeys=new Set(finalRp.map(x=>`${String(x.room_type_id)}|${String(x.name||'').trim().toLowerCase()}`));
       for(const rplan of (legacyRates||[])){
         const target=unitMap.get(String(rplan.unit_type_id)) || finalRt.find(x=>String(x.id)===String(rplan.unit_type_id));
         const roomId=target?.room_type_id||target?.id;
         if(!roomId) continue;
         const key=`${String(roomId)}|${String(rplan.name||'').trim().toLowerCase()}`;
         if(!canonicalRateKeys.has(key)){
           finalRp.push({...rplan,id:rplan.id,room_type_id:roomId,hospitality_type:'camp',pricing_mode:rplan.pricing_mode||'per_person'});
           canonicalRateKeys.add(key);
         }
       }
       const roomKey=(x)=>String(x?.room_type_id||x?.unit_type_id||'');
       const existingInv=new Set(finalInv.map(x=>`${String(x.room_type_id)}|${String(x.stay_date)}`));
       for(const i of (legacyInv||[])){
         const target=unitMap.get(String(i.unit_type_id)); const roomId=target?.room_type_id||target?.id;
         if(!roomId) continue;
         const key=`${String(roomId)}|${String(i.stay_date)}`;
         if(!existingInv.has(key)){
           finalInv.push({id:i.id,room_type_id:roomId,stay_date:i.stay_date,total_rooms:i.total_units,sold_rooms:Number(i.sold_units||0)+Number(i.held_units||0),blocked_rooms:i.blocked_units,closed:i.closed});
           existingInv.add(key);
         }
       }
       const existingRes=new Set(finalRs.map(x=>String(x.id)));
       for(const reservation of (legacyRes||[])){ if(!existingRes.has(String(reservation.id))) finalRs.push({...reservation,room_type_id:unitMap.get(String(reservation.unit_type_id))?.room_type_id||reservation.unit_type_id}); }
     }

     // Inventory and reservations are keyed by room/unit type. Scope them to the
     // active hospitality catalog so Hotel rows can never appear in a Camping store.
     const activeTypeIds=new Set(finalRt.map(x=>String(x.id||x.room_type_id)));
     finalInv=finalInv.filter(x=>activeTypeIds.has(String(x.room_type_id||x.unit_type_id)));
     finalRs=finalRs.filter(x=>activeTypeIds.has(String(x.room_type_id||x.unit_type_id)));
     setHotelRoomTypes(finalRt);setHotelRatePlans(finalRp);setHotelInventory(finalInv);setHotelReservations(finalRs);setOrders(finalRs);
   }
 }

 async function addHomeBanner(){if(!store||!form.banner_title||!form.banner_image_url){setError('Banner title and image are required.');return}const {data,error}=await supabase.from('anaira_store_banners').insert({store_id:store.id,restaurant_id:rid,title:form.banner_title,subtitle:form.banner_subtitle||null,image_url:form.banner_image_url,mobile_image_url:form.banner_mobile_image_url||null,cta_label:form.banner_cta_label||null,cta_url:form.banner_cta_url||null,display_order:homeBanners.length,active:true}).select('*').single();if(error){setError(error.message);return}setHomeBanners(x=>[...x,data]);setForm(x=>({...x,banner_title:'',banner_subtitle:'',banner_image_url:'',banner_mobile_image_url:'',banner_cta_label:'',banner_cta_url:''}));}
 async function toggleHomeBanner(b){const {error}=await supabase.from('anaira_store_banners').update({active:!b.active,updated_at:new Date().toISOString()}).eq('id',b.id);if(!error)setHomeBanners(x=>x.map(i=>i.id===b.id?{...i,active:!b.active}:i));}
 async function toggleFeatured(item){if(!store)return;const existing=featuredItems.find(x=>String(x.external_item_id)===String(item.id));if(existing){const {error}=await supabase.from('anaira_marketplace_featured_items').update({active:!existing.active,updated_at:new Date().toISOString()}).eq('id',existing.id);if(!error)setFeaturedItems(x=>x.map(i=>i.id===existing.id?{...i,active:!existing.active}:i));}else{const {data,error}=await supabase.from('anaira_marketplace_featured_items').insert({store_id:store.id,restaurant_id:rid,external_item_id:String(item.id),title_override:null,image_override:item.image||item.image_url||null,badge:'Popular',display_order:featuredItems.length,active:true}).select('*').single();if(!error)setFeaturedItems(x=>[...x,data]);}}
 async function saveStore(){if(!store||!rid)return;setBusy(true);setSaved(false);setError('');
   const gallery=String(form.galleryText??(form.gallery||[]).join('\n')).split(/\n|,/).map(x=>x.trim()).filter(Boolean);
   const listing=storeKind==='hotel'?{hospitality_types:property?.hospitality_types||[activeHospitalityType],title:form.title||property?.name,tagline:form.tagline,description:form.description,logo_url:form.logo_url,cover_url:form.cover_url,gallery,phone:form.phone,whatsapp:form.whatsapp,website:form.website,address:form.address,city:form.city,state:form.state,postal_code:form.postal_code,seo_title:form.seo_title,seo_description:form.seo_description}:{title:form.title,tagline:form.tagline,description:form.description,logo_url:form.logo_url,cover_url:form.cover_url,gallery,phone:form.phone,whatsapp:form.whatsapp,website:form.website,address:form.address,city:form.city,state:form.state,postal_code:form.postal_code,seo_title:form.seo_title,seo_description:form.seo_description};
   const source=form.catalog_source||(storeKind==='restaurant'?'anaira_pos':'anaira_hms');
   const payload={listing_override:listing,enabled:true,catalog_source:source,integration_connection_id:form.integration_connection_id||null,manual_catalog_enabled:source==='manual',store_config:{delivery:!!form.delivery,pickup:!!form.pickup,dine_in:!!form.dine_in,min_order_amount:Number(form.min_order_amount)||0,delivery_fee:Number(form.delivery_fee)||0,delivery_radius_km:form.delivery_radius_km===''?null:Number(form.delivery_radius_km),tax_percent:Number(form.tax_percent)||0,theme_mode:form.theme_mode||'light',accent_color:form.accent_color||'#0b6b4f',announcement:form.announcement||'',social_instagram:form.social_instagram||'',social_facebook:form.social_facebook||'',social_whatsapp:form.social_whatsapp||'',delivery_eta_minutes:Number(form.delivery_eta_minutes)||45,service_fee:Number(form.service_fee)||0,order_notes_enabled:!!form.order_notes_enabled,show_popular:!!form.show_popular,show_offers:!!form.show_offers,show_gallery:!!form.show_gallery,show_reviews:!!form.show_reviews,hero_overlay:Number(form.hero_overlay)||0.45,card_radius:Number(form.card_radius)||20,store_background:form.store_background||'#f7f5ef',show_categories:!!form.show_categories,show_search:!!form.show_search,show_cart:!!form.show_cart,show_announcement:!!form.show_announcement,show_footer:!!form.show_footer,hero_cta_label:form.hero_cta_label||'Order Now',hero_cta_url:form.hero_cta_url||'',gallery_title:form.gallery_title||'Our Place',gallery_subtitle:form.gallery_subtitle||'A look inside our restaurant',feature_icons:featureIcons,about_title:form.about_title||'',about_subtitle:form.about_subtitle||'',about_text:form.about_text||'',category_title:form.category_title||'Menu Categories',category_subtitle:form.category_subtitle||'Explore dishes from our kitchen',popular_title:form.popular_title||'Popular Dishes',offer_title:form.offer_title||'Delicious Food, Special Moments',offer_text:form.offer_text||'',offer_cta:form.offer_cta||'Order Now',reservation_title:form.reservation_title||'Plan Your Visit',reservation_text:form.reservation_text||'',reservation_cta:form.reservation_cta||'Book Now',reviews_title:form.reviews_title||'Customer Reviews',reviews_subtitle:form.reviews_subtitle||'',testimonials:Array.isArray(form.testimonials)?form.testimonials:[],menu_title:form.menu_title||'Order from our kitchen'}};
   const r=membership?await supabase.from('anaira_store_memberships').update(payload).eq('id',membership.id):await supabase.from('anaira_store_memberships').insert({store_id:store.id,restaurant_id:rid,...payload});
   if(r.error){setError(r.error.message);setBusy(false);return}
   const sp={restaurant_id:rid,store_id:store.id,store_type:storeKind,seo_title:form.seo_title||null,seo_description:form.seo_description||null,min_order_amount:Number(form.min_order_amount)||0,delivery_fee:Number(form.delivery_fee)||0,delivery_radius_km:form.delivery_radius_km===''?null:Number(form.delivery_radius_km),tax_percent:Number(form.tax_percent)||0,timings:{open:form.open_time,close:form.close_time},payment_methods:String(form.payment_methods||'').split(',').map(x=>x.trim()).filter(Boolean),published:true};
   const sr=await supabase.from('anaira_store_settings').upsert(sp,{onConflict:'store_id,restaurant_id'}); if(sr.error){setError(sr.error.message);setBusy(false);return}
   await supabase.from('anaira_store_activity_log').insert({store_id:store.id,restaurant_id:rid,actor_user_id:session?.user?.id,action:'store.configuration.updated',details:{catalog_source:source}});
   setSaved(true);await load();setBusy(false);
 }
 async function saveCategory(){if(!categoryForm.name.trim())return;setBusy(true);const payload={restaurant_id:rid,store_id:store.id,name:categoryForm.name.trim(),description:categoryForm.description||null,image_url:categoryForm.image_url||null,display_order:Number(categoryForm.display_order)||0,active:!!categoryForm.active};const r=categoryForm.id?await supabase.from('anaira_store_categories').update(payload).eq('id',categoryForm.id):await supabase.from('anaira_store_categories').insert(payload);if(r.error)setError(r.error.message);else{setCategoryForm(blankCategory);await load()}setBusy(false)}
 async function deleteCategory(id){if(!confirm('Delete this category? Items will remain but lose the category link.'))return;const r=await supabase.from('anaira_store_categories').delete().eq('id',id);if(r.error)setError(r.error.message);else await load()}
 async function saveItem(){if(!itemForm.item_name.trim()||!itemForm.price)return;setBusy(true);const cat=categories.find(c=>c.id===itemForm.category_id);const payload={restaurant_id:rid,item_name:itemForm.item_name.trim(),category_id:itemForm.category_id||null,category_name:cat?.name||itemForm.category_name||'Uncategorised',description:itemForm.description||null,price:Number(itemForm.price),discount_price:itemForm.discount_price===''?null:Number(itemForm.discount_price),image_url:itemForm.image_url||null,veg_type:itemForm.veg_type,tags:String(itemForm.tags||'').split(',').map(x=>x.trim()).filter(Boolean),prep_time_minutes:itemForm.prep_time_minutes===''?null:Number(itemForm.prep_time_minutes),tax_percent:itemForm.tax_percent===''?0:Number(itemForm.tax_percent),featured:!!itemForm.featured,active:!!itemForm.active,display_order:Number(itemForm.display_order)||0,updated_at:new Date().toISOString()};const r=itemForm.id?await supabase.from('anaira_marketplace_menu_items').update(payload).eq('id',itemForm.id).eq('restaurant_id',rid):await supabase.from('anaira_marketplace_menu_items').insert(payload);if(r.error)setError(r.error.message);else{setItemForm(blankItem);await load()}setBusy(false)}
 async function deleteItem(id){if(!confirm('Delete this menu item?'))return;const r=await supabase.from('anaira_marketplace_menu_items').delete().eq('id',id).eq('restaurant_id',rid);if(r.error)setError(r.error.message);else{if(selectedItem?.id===id)setSelectedItem(null);await load()}}
 async function openOptions(item){setSelectedItem(item);const [{data:v},{data:a}]=await Promise.all([supabase.from('anaira_store_item_variants').select('*').eq('menu_item_id',item.id).order('display_order'),supabase.from('anaira_store_item_addons').select('*').eq('menu_item_id',item.id).order('display_order')]);setVariants(v||[]);setAddons(a||[])}
 async function addOption(kind){if(!selectedItem)return;const data={menu_item_id:selectedItem.id,name:(kind==='variant'?newVariant:newAddon).name,price:Number((kind==='variant'?newVariant:newAddon).price)||0};const r=await supabase.from(kind==='variant'?'anaira_store_item_variants':'anaira_store_item_addons').insert(data);if(r.error)setError(r.error.message);else{kind==='variant'?setNewVariant(blankOption):setNewAddon(blankOption);await openOptions(selectedItem)}}
 async function deleteOption(kind,id){const r=await supabase.from(kind==='variant'?'anaira_store_item_variants':'anaira_store_item_addons').delete().eq('id',id);if(r.error)setError(r.error.message);else await openOptions(selectedItem)}
 async function saveOffer(){if(!newOffer.code||!newOffer.title||!newOffer.discount_value)return;const r=await supabase.from('anaira_store_offers').insert({restaurant_id:rid,store_id:store.id,code:newOffer.code.toUpperCase(),title:newOffer.title,description:newOffer.description||null,discount_type:newOffer.discount_type,discount_value:Number(newOffer.discount_value),min_order_amount:Number(newOffer.min_order_amount)||0,active:true});if(r.error)setError(r.error.message);else{setNewOffer({code:'',title:'',description:'',discount_type:'percent',discount_value:'',min_order_amount:0,active:true});await load()}}
 async function toggleOffer(o){const r=await supabase.from('anaira_store_offers').update({active:!o.active}).eq('id',o.id);if(r.error)setError(r.error.message);else await load()}

 const source=form.catalog_source||(storeKind==='restaurant'?'anaira_pos':'anaira_hms');
 const hospitalityLabel={hotel:'Hotel',camp:'Camping',homestay:'Homestay',guest_house:'Guest House',cottage:'Cottage'}[activeHospitalityType]||'Hospitality';
 const storeName=kind==='restaurant'?'My Restaurant Store':`My ${hospitalityLabel} Store`;
 const publicUrl=kind==='restaurant'?`/store/${rid}`:`/book/${rid}?stay_type=${encodeURIComponent(activeHospitalityType)}`;
 const grouped=useMemo(()=>categories,[categories]);
 if(session===undefined)return <div className="notice">Connecting…</div>;
 if(!session)return <AppShell><div className="auth-card"><h1>Sign in required</h1><a className="btn primary" href="/login">Open CRM Login</a></div></AppShell>;
 return <AppShell active="/store-builder">
  <div className="sb-page">
   <div className="sb-hero">
    <div><div className="sb-eyebrow">ANAIRA BUSINESS STORE</div><h1>{storeName}</h1><p>Build and control your own customer-facing store. Restaurant SaaS remains the operational source of truth.</p></div>
    <div className="sb-actions">{kind!=='restaurant'&&availableKinds.filter(k=>k!=='restaurant').length>1&&<select className="compact-input" value={activeHospitalityType} onChange={e=>{const next=e.target.value;setActiveHospitalityType(next);setKind(next);router.replace(`/store-builder?kind=${encodeURIComponent(next)}&hospitality_type=${encodeURIComponent(next)}`);}}>{availableKinds.filter(k=>k!=='restaurant').map(k=><option key={k} value={k}>{`My ${{hotel:'Hotel',camp:'Camping',homestay:'Homestay',guest_house:'Guest House',cottage:'Cottage'}[k]||'Hospitality'} Store`}</option>)}</select>}<a className="btn" href={publicUrl} target="_blank">Preview Store ↗</a><button className="btn primary" disabled={busy} onClick={saveStore}>{busy?'Saving…':'Save Changes'}</button></div>
   </div>
   {error&&<div className="notice error">{error}</div>}
   {!store?<div className="notice">This platform store is disabled or unpublished by Super Admin.</div>:<>
    <div className="sb-kpis"><div><span>BUSINESS</span><b>{property?.name||rid.slice(0,8)}</b><small>Business Admin scope</small></div><div><span>CATALOG SOURCE</span><b>{sourceLabels[source]||source}</b><small>Single source of truth</small></div><div><span>{storeKind==='restaurant'?'MENU ITEMS':'BOOKINGS'}</span><b>{storeKind==='restaurant'?items.length:orders.length}</b><small>Live operational data</small></div><div><span>STORE</span><b>Connected</b><small>{publicUrl}</small></div></div>
    {storeKind==='restaurant'?<>
      <StoreTabNav active={storeTab} onChange={setStoreTab}/>

      {storeTab==='overview'&&<div className="sb-panel-grid">
       <Section title="Store Command Center" meta="Everything important about your customer-facing restaurant store."><div className="sb-card-grid">
        <article className="sb-stat-card"><span>Store status</span><strong>LIVE</strong><small>Business store is connected to ANAIRA Restaurant SaaS.</small></article>
        <article className="sb-stat-card"><span>Menu</span><strong>{liveMenu.length||items.length}</strong><small>Items available from the connected catalog.</small></article>
        <article className="sb-stat-card"><span>Categories</span><strong>{categories.length}</strong><small>Customer navigation categories.</small></article>
        <article className="sb-stat-card"><span>Promotions</span><strong>{offers.length}</strong><small>Restaurant-owned offers and coupons.</small></article>
       </div></Section>
       <Section title="Quick Actions" meta="Jump directly to the part of your store you want to manage."><div className="sb-quick-grid">{[['branding','🎨','Brand & Media','Logo, cover, gallery, colors and customer-facing identity'],['homepage','🖼️','Homepage','Hero banners, mobile creatives and featured dishes'],['operations','🛍️','Ordering','Delivery, pickup, dine-in, fees, tax and timings'],['catalog','🍽️','Catalog','Categories, items, variants and add-ons'],['offers','🏷️','Offers','Coupons, discounts and promotional rules'],['seo','🔎','SEO & Publish','SEO, social links and final publish']].map(([id,icon,title,desc])=><button key={id} type="button" onClick={()=>setStoreTab(id)}><span>{icon}</span><div><b>{title}</b><small>{desc}</small></div><em>›</em></button>)}</div></Section>
       <Section title="Store Ownership Boundary" meta="Your store controls only presentation and business-level settings."><div className="sb-info"><b>Restaurant SaaS → SOURCE</b><span>Menu, categories, items, variants, add-ons, prices, availability, inventory, POS orders and operational delivery data.</span><b>My Store → PRESENTATION</b><span>Branding, images, banners, featured dishes, ordering preferences, customer experience, offers, SEO and store visibility.</span></div></Section>
      </div>}

      {storeTab==='branding'&&<div className="sb-tab-content">
       <Section title="Restaurant Identity" meta="Your public brand identity. Operational restaurant master remains in Restaurant SaaS."><div className="sb-form-grid"><Field label="Store Name"><input className="compact-input" value={form.title} onChange={e=>setForm({...form,title:e.target.value})}/></Field><Field label="Tagline"><input className="compact-input" value={form.tagline} onChange={e=>setForm({...form,tagline:e.target.value})}/></Field><UploadField label="Logo" value={form.logo_url} restaurantId={rid} folder="store/logo" onChange={v=>setForm({...form,logo_url:v})}/><UploadField label="Cover / Hero Image" value={form.cover_url} restaurantId={rid} folder="store/cover" onChange={v=>setForm({...form,cover_url:v})}/><Field label="Phone"><input className="compact-input" value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})}/></Field><Field label="WhatsApp"><input className="compact-input" value={form.whatsapp} onChange={e=>setForm({...form,whatsapp:e.target.value})}/></Field><Field label="Website"><input className="compact-input" value={form.website} onChange={e=>setForm({...form,website:e.target.value})}/></Field><Field label="City"><input className="compact-input" value={form.city} onChange={e=>setForm({...form,city:e.target.value})}/></Field><Field label="Address" wide><input className="compact-input" value={form.address} onChange={e=>setForm({...form,address:e.target.value})}/></Field><Field label="Store Description" wide><textarea className="compact-input" style={{minHeight:110}} value={form.description} onChange={e=>setForm({...form,description:e.target.value})}/></Field></div></Section>
       <Section title="Gallery & Visual Experience" meta="Upload every image directly; no image URL copying is required."><div className="sb-form-grid"><UploadField label="Restaurant Gallery" value={form.gallery||[]} multiple restaurantId={rid} folder="store/gallery" onChange={v=>setForm({...form,gallery:v})}/><div className="sb-preview-card"><span>Live preview</span><div style={{backgroundImage:form.cover_url?`linear-gradient(90deg,#07140dcc,#07140d55),url(${form.cover_url})`:'linear-gradient(120deg,#073b2b,#14563e)'}}><img src={form.logo_url||'/assets/anaira-logo.webp'} alt=""/><b>{form.title||'Your Restaurant'}</b></div></div></div></Section>
       <Section title="Visual Style" meta="Customer-facing store appearance."><div className="sb-form-grid"><Field label="Theme"><select className="compact-input" value={form.theme_mode||'light'} onChange={e=>setForm({...form,theme_mode:e.target.value})}><option value="light">Light</option><option value="dark">Dark</option><option value="forest">Forest</option></select></Field><Field label="Accent Color"><input className="compact-input" type="color" value={form.accent_color||'#0b6b4f'} onChange={e=>setForm({...form,accent_color:e.target.value})}/></Field><Field label="Hero Overlay"><input className="compact-input" type="number" min="0" max="0.9" step="0.05" value={form.hero_overlay} onChange={e=>setForm({...form,hero_overlay:e.target.value})}/></Field><Field label="Card Radius (px)"><input className="compact-input" type="number" min="8" max="40" value={form.card_radius} onChange={e=>setForm({...form,card_radius:e.target.value})}/></Field><Field label="Store Background"><input className="compact-input" type="color" value={form.store_background||'#f7f5ef'} onChange={e=>setForm({...form,store_background:e.target.value})}/></Field></div></Section>
      </div>}

      {storeTab==='homepage'&&<div className="sb-tab-content">
       <Section title="Restaurant Marketplace Homepage — Homepage Promotional Banners" meta="Create premium promotional creatives with separate desktop and mobile images."><div className="sb-form-grid"><Field label="Banner Title"><input className="compact-input" value={form.banner_title||''} onChange={e=>setForm({...form,banner_title:e.target.value})}/></Field><Field label="Banner Subtitle"><input className="compact-input" value={form.banner_subtitle||''} onChange={e=>setForm({...form,banner_subtitle:e.target.value})}/></Field><UploadField label="Desktop Banner Image" value={form.banner_image_url} restaurantId={rid} folder="store/banners" onChange={v=>setForm({...form,banner_image_url:v})}/><UploadField label="Mobile Banner Image" value={form.banner_mobile_image_url} restaurantId={rid} folder="store/banners-mobile" onChange={v=>setForm({...form,banner_mobile_image_url:v})}/><Field label="CTA Label"><input className="compact-input" value={form.banner_cta_label||''} onChange={e=>setForm({...form,banner_cta_label:e.target.value})}/></Field><Field label="CTA URL"><input className="compact-input" value={form.banner_cta_url||''} onChange={e=>setForm({...form,banner_cta_url:e.target.value})}/></Field></div><button className="btn primary" onClick={addHomeBanner}>Add Homepage Banner</button><div className="sb-banner-list">{homeBanners.map(b=><article key={b.id}><img src={b.image_url} alt=""/><div><b>{b.title}</b><small>{b.subtitle||'No subtitle'} · {b.active?'LIVE':'DISABLED'}</small></div><button className="btn" onClick={()=>toggleHomeBanner(b)}>{b.active?'Disable':'Enable'}</button></article>)}</div></Section>
       <Section title="Premium Store Experience" meta="Control the customer-facing Store / ID page: headings, about, offers, reservation, reviews and feature buttons."><div className="sb-form-grid"><Field label="Popular Dishes Title"><input className="compact-input" value={form.popular_title||''} onChange={e=>setForm({...form,popular_title:e.target.value})}/></Field><Field label="Menu Categories Title"><input className="compact-input" value={form.category_title||''} onChange={e=>setForm({...form,category_title:e.target.value})}/></Field><Field label="Categories Subtitle"><input className="compact-input" value={form.category_subtitle||''} onChange={e=>setForm({...form,category_subtitle:e.target.value})}/></Field><Field label="Menu Title"><input className="compact-input" value={form.menu_title||''} onChange={e=>setForm({...form,menu_title:e.target.value})}/></Field><Field label="About Title"><input className="compact-input" value={form.about_title||''} onChange={e=>setForm({...form,about_title:e.target.value})}/></Field><Field label="About Subtitle"><input className="compact-input" value={form.about_subtitle||''} onChange={e=>setForm({...form,about_subtitle:e.target.value})}/></Field><Field label="About Story" wide><textarea className="compact-input" value={form.about_text||''} onChange={e=>setForm({...form,about_text:e.target.value})}/></Field><Field label="Offer Title"><input className="compact-input" value={form.offer_title||''} onChange={e=>setForm({...form,offer_title:e.target.value})}/></Field><Field label="Offer CTA"><input className="compact-input" value={form.offer_cta||''} onChange={e=>setForm({...form,offer_cta:e.target.value})}/></Field><Field label="Offer Text" wide><textarea className="compact-input" value={form.offer_text||''} onChange={e=>setForm({...form,offer_text:e.target.value})}/></Field><Field label="Reservation Title"><input className="compact-input" value={form.reservation_title||''} onChange={e=>setForm({...form,reservation_title:e.target.value})}/></Field><Field label="Reservation CTA"><input className="compact-input" value={form.reservation_cta||''} onChange={e=>setForm({...form,reservation_cta:e.target.value})}/></Field><Field label="Reservation Text" wide><textarea className="compact-input" value={form.reservation_text||''} onChange={e=>setForm({...form,reservation_text:e.target.value})}/></Field><Field label="Reviews Title"><input className="compact-input" value={form.reviews_title||''} onChange={e=>setForm({...form,reviews_title:e.target.value})}/></Field><Field label="Reviews Subtitle"><input className="compact-input" value={form.reviews_subtitle||''} onChange={e=>setForm({...form,reviews_subtitle:e.target.value})}/></Field></div></Section>
       <Section title="Food Feature Icon Buttons" meta="Every icon is a real clickable button. It can open the menu, a category, an offer, gallery, about, reservation, a specific dish, or an external URL."><div className="sb-feature-icon-editor">{featureIcons.map((f,i)=><div className="sb-feature-icon-row sb-feature-rich" key={i}><input className="compact-input icon-input" value={f.icon||''} onChange={e=>setFeatureIcons(a=>a.map((x,n)=>n===i?{...x,icon:e.target.value}:x))} placeholder="🍽️"/><input className="compact-input" value={f.title||''} onChange={e=>setFeatureIcons(a=>a.map((x,n)=>n===i?{...x,title:e.target.value}:x))} placeholder="Fresh Food"/><input className="compact-input" value={f.text||''} onChange={e=>setFeatureIcons(a=>a.map((x,n)=>n===i?{...x,text:e.target.value}:x))} placeholder="Short description"/><select className="compact-input" value={f.action_type||'menu'} onChange={e=>setFeatureIcons(a=>a.map((x,n)=>n===i?{...x,action_type:e.target.value,action_value:''}:x))}><option value="menu">Open Menu</option><option value="category">Open Category</option><option value="item">Open Dish</option><option value="offers">Open Offers</option><option value="gallery">Open Gallery</option><option value="about">Open About</option><option value="reservation">Book Table</option><option value="url">Open URL</option></select><input className="compact-input" value={f.action_value||''} onChange={e=>setFeatureIcons(a=>a.map((x,n)=>n===i?{...x,action_value:e.target.value}:x))} placeholder="Category / Dish ID / URL"/><button className="btn" type="button" onClick={()=>setFeatureIcons(a=>a.filter((_,n)=>n!==i))}>Remove</button></div>)}<div><button className="btn" type="button" onClick={()=>setFeatureIcons(a=>[...a,{icon:'✦',title:'New Feature',text:'Restaurant experience',action_type:'menu',action_value:''}])}>+ Add Feature</button><button className="btn primary" type="button" onClick={saveStore}>Save Feature Buttons</button></div></div></Section>
       <Section title="Customer Reviews" meta="Add the testimonials shown on the public Store / ID page."><div className="sb-form-grid"><Field label="Testimonials JSON" wide><textarea className="compact-input sb-json-area" value={JSON.stringify(form.testimonials||[],null,2)} onChange={e=>{try{setForm({...form,testimonials:JSON.parse(e.target.value)})}catch{}}} placeholder='[{"name":"Rohit Sharma","text":"Amazing food and ambience","meta":"Local Guide"}]'/></Field></div></Section>
       <Section title="Homepage Sections" meta="Choose which customer-facing sections your restaurant store presents."><div className="sb-toggle-grid">{[['show_search','Search'],['show_categories','Category navigation'],['show_popular','Popular dishes'],['show_offers','Offers'],['show_gallery','Gallery'],['show_reviews','Reviews'],['show_cart','Shopping cart'],['show_announcement','Announcement strip'],['show_footer','Footer']].map(([k,l])=><label key={k}><input type="checkbox" checked={!!form[k]} onChange={e=>setForm({...form,[k]:e.target.checked})}/><span>{l}</span></label>)}</div></Section>
       <Section title="Featured Dishes" meta="Curate presentation from the connected live Restaurant SaaS menu; no duplicate operational master."><div className="sb-item-grid">{liveMenu.slice(0,100).map(item=>{const active=featuredItems.some(x=>String(x.external_item_id)===String(item.id)&&x.active);return <label key={item.id} className={active?'selected':''}><input type="checkbox" checked={active} onChange={()=>toggleFeatured(item)}/>{(item.image||item.image_url)?<img src={item.image||item.image_url} alt=""/>:<div className="sb-item-placeholder">🍽️</div>}<span><b>{item.name||item.item_name}</b><small>₹{item.price}</small></span></label>})}</div></Section>
      </div>}

      {storeTab==='operations'&&<div className="sb-tab-content">
       <Section title="Ordering Modes" meta="Choose which customer ordering experiences are available."><div className="sb-toggle-grid">{[['delivery','Delivery'],['pickup','Pickup'],['dine_in','Dine-in'],['order_notes_enabled','Customer order notes']].map(([k,l])=><label key={k}><input type="checkbox" checked={!!form[k]} onChange={e=>setForm({...form,[k]:e.target.checked})}/><span>{l}</span></label>)}</div></Section>
       <Section title="Delivery & Charges" meta="Business-level commercial settings used by your store checkout."><div className="sb-form-grid"><Field label="Minimum Order"><input className="compact-input" type="number" min="0" value={form.min_order_amount} onChange={e=>setForm({...form,min_order_amount:e.target.value})}/></Field><Field label="Delivery Fee"><input className="compact-input" type="number" min="0" value={form.delivery_fee} onChange={e=>setForm({...form,delivery_fee:e.target.value})}/></Field><Field label="Delivery Radius (km)"><input className="compact-input" type="number" min="0" value={form.delivery_radius_km} onChange={e=>setForm({...form,delivery_radius_km:e.target.value})}/></Field><Field label="Tax %"><input className="compact-input" type="number" min="0" value={form.tax_percent} onChange={e=>setForm({...form,tax_percent:e.target.value})}/></Field><Field label="Service Fee"><input className="compact-input" type="number" min="0" value={form.service_fee} onChange={e=>setForm({...form,service_fee:e.target.value})}/></Field><Field label="Estimated Delivery (minutes)"><input className="compact-input" type="number" min="1" value={form.delivery_eta_minutes} onChange={e=>setForm({...form,delivery_eta_minutes:e.target.value})}/></Field></div></Section>
       <Section title="Business Hours & Payments" meta="Customer-facing operating hours and available payment methods."><div className="sb-form-grid"><Field label="Opening Time"><input className="compact-input" type="time" value={form.open_time} onChange={e=>setForm({...form,open_time:e.target.value})}/></Field><Field label="Closing Time"><input className="compact-input" type="time" value={form.close_time} onChange={e=>setForm({...form,close_time:e.target.value})}/></Field><Field label="Payment Methods" wide><input className="compact-input" value={form.payment_methods} onChange={e=>setForm({...form,payment_methods:e.target.value})} placeholder="online,cash,pay_on_delivery"/></Field><Field label="Announcement" wide><input className="compact-input" value={form.announcement} onChange={e=>setForm({...form,announcement:e.target.value})} placeholder="Free delivery above ₹499 today"/></Field></div></Section>
      </div>}

      {storeTab==='catalog'&&<div className="sb-tab-content">
       <Section title="Catalog Source" meta="Select where the operational restaurant catalog comes from."><div className="sb-source-grid">{[['anaira_pos','ANAIRA POS','Live restaurant catalog and order bridge.'],['external_integration','External Software','REST API / webhook / POS integration.'],['manual','Manual Catalog','Admin-managed catalog with categories, variants and add-ons.']].map(([v,t,d])=><button key={v} type="button" className={source===v?'selected':''} onClick={()=>setForm({...form,catalog_source:v})}><b>{t}</b><small>{d}</small></button>)}</div>{source==='external_integration'&&<Field label="Connected integration"><select className="compact-input" value={form.integration_connection_id} onChange={e=>setForm({...form,integration_connection_id:e.target.value})}><option value="">Select integration</option>{connections.map(c=><option key={c.id} value={c.id}>{c.name} · {c.provider} · {c.status}</option>)}</select></Field>}</Section>
       <Section title="Categories" meta="Category names, descriptions and images used by the store."><div className="sb-form-grid"><Field label="Category"><input className="compact-input" value={categoryForm.name} onChange={e=>setCategoryForm({...categoryForm,name:e.target.value})}/></Field><Field label="Description"><input className="compact-input" value={categoryForm.description} onChange={e=>setCategoryForm({...categoryForm,description:e.target.value})}/></Field><UploadField label="Category Image" value={categoryForm.image_url} restaurantId={rid} folder="menu/categories" onChange={v=>setCategoryForm({...categoryForm,image_url:v})}/><div><button className="btn primary" onClick={saveCategory}>{categoryForm.id?'Update Category':'Add Category'}</button></div></div><div className="sb-list">{grouped.map(c=><div key={c.id}><span><b>{c.name}</b><small>{c.description||'No description'}</small></span><div><button className="btn" onClick={()=>setCategoryForm(c)}>Edit</button><button className="btn" onClick={()=>deleteCategory(c.id)}>Delete</button></div></div>)}</div></Section>
       <Section title="Menu Items" meta="Images, price, discounts, dietary type, tags and preparation data."><div className="sb-form-grid"><Field label="Item Name"><input className="compact-input" value={itemForm.item_name} onChange={e=>setItemForm({...itemForm,item_name:e.target.value})}/></Field><Field label="Category"><select className="compact-input" value={itemForm.category_id} onChange={e=>setItemForm({...itemForm,category_id:e.target.value})}><option value="">Uncategorised</option>{categories.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select></Field><Field label="Price"><input className="compact-input" type="number" value={itemForm.price} onChange={e=>setItemForm({...itemForm,price:e.target.value})}/></Field><Field label="Discount Price"><input className="compact-input" type="number" value={itemForm.discount_price} onChange={e=>setItemForm({...itemForm,discount_price:e.target.value})}/></Field><UploadField label="Dish Image" value={itemForm.image_url} restaurantId={rid} folder="menu/items" onChange={v=>setItemForm({...itemForm,image_url:v})}/><Field label="Veg / Non-Veg"><select className="compact-input" value={itemForm.veg_type} onChange={e=>setItemForm({...itemForm,veg_type:e.target.value})}><option value="veg">Veg</option><option value="non_veg">Non-Veg</option></select></Field><Field label="Prep Time (min)"><input className="compact-input" type="number" value={itemForm.prep_time_minutes} onChange={e=>setItemForm({...itemForm,prep_time_minutes:e.target.value})}/></Field><Field label="Tax %"><input className="compact-input" type="number" value={itemForm.tax_percent} onChange={e=>setItemForm({...itemForm,tax_percent:e.target.value})}/></Field><Field label="Tags" wide><input className="compact-input" value={itemForm.tags} onChange={e=>setItemForm({...itemForm,tags:e.target.value})} placeholder="spicy, bestseller, chef-special"/></Field><Field label="Description" wide><textarea className="compact-input" value={itemForm.description} onChange={e=>setItemForm({...itemForm,description:e.target.value})}/></Field><div className="sb-toggle-grid"><label><input type="checkbox" checked={!!itemForm.featured} onChange={e=>setItemForm({...itemForm,featured:e.target.checked})}/><span>Featured</span></label><label><input type="checkbox" checked={!!itemForm.active} onChange={e=>setItemForm({...itemForm,active:e.target.checked})}/><span>Active</span></label></div><div><button className="btn primary" onClick={saveItem}>{itemForm.id?'Update Item':'Add Item'}</button></div></div><div className="sb-list">{items.slice(0,100).map(i=><div key={i.id}><span><b>{i.item_name}</b><small>{i.category_name||'Uncategorised'} · ₹{i.discount_price??i.price}</small></span><div><button className="btn" onClick={()=>openOptions(i)}>Variants / Add-ons</button><button className="btn" onClick={()=>setItemForm({...i,tags:Array.isArray(i.tags)?i.tags.join(', '):i.tags||''})}>Edit</button><button className="btn" onClick={()=>deleteItem(i.id)}>Delete</button></div></div>)}</div></Section>
      </div>}

      {storeTab==='offers'&&<div className="sb-tab-content"><Section title="Offers & Coupons" meta="Business-owned promotional rules for your store."><div className="sb-form-grid"><Field label="Coupon Code"><input className="compact-input" value={newOffer.code} onChange={e=>setNewOffer({...newOffer,code:e.target.value})}/></Field><Field label="Offer Title"><input className="compact-input" value={newOffer.title} onChange={e=>setNewOffer({...newOffer,title:e.target.value})}/></Field><Field label="Discount Type"><select className="compact-input" value={newOffer.discount_type} onChange={e=>setNewOffer({...newOffer,discount_type:e.target.value})}><option value="percent">Percentage</option><option value="amount">Fixed Amount</option></select></Field><Field label="Discount Value"><input className="compact-input" type="number" value={newOffer.discount_value} onChange={e=>setNewOffer({...newOffer,discount_value:e.target.value})}/></Field><Field label="Minimum Order"><input className="compact-input" type="number" value={newOffer.min_order_amount} onChange={e=>setNewOffer({...newOffer,min_order_amount:e.target.value})}/></Field><Field label="Description"><input className="compact-input" value={newOffer.description} onChange={e=>setNewOffer({...newOffer,description:e.target.value})}/></Field><div><button className="btn primary" onClick={saveOffer}>Create Offer</button></div></div><div className="sb-list">{offers.map(o=><div key={o.id}><span><b>{o.code} · {o.title}</b><small>{o.discount_type==='percent'?`${o.discount_value}% OFF`:`₹${o.discount_value} OFF`} · min ₹{o.min_order_amount||0}</small></span><button className="btn" onClick={()=>toggleOffer(o)}>{o.active?'Disable':'Enable'}</button></div>)}</div></Section></div>}

      {storeTab==='integrations'&&<div className="sb-tab-content"><Section title="Integration & Source of Truth" meta="Connect presentation to the operational restaurant system without duplicating the master data."><div className="sb-source-grid">{[['anaira_pos','ANAIRA POS','Recommended live source.'],['external_integration','External Software','Use an approved connected provider.'],['manual','Manual Catalog','Use only when the business operates its own store catalog.']].map(([v,t,d])=><button key={v} type="button" className={source===v?'selected':''} onClick={()=>setForm({...form,catalog_source:v})}><b>{t}</b><small>{d}</small></button>)}</div><div className="sb-connection-list">{connections.length?connections.map(c=><div key={c.id}><b>{c.name}</b><span>{c.provider} · {c.integration_type} · {c.status}</span></div>):<div className="muted">No integration connections configured for this business.</div>}</div></Section></div>}

      {storeTab==='seo'&&<div className="sb-tab-content"><Section title="SEO & Social" meta="Improve discovery and sharing of your restaurant store."><div className="sb-form-grid"><Field label="SEO Title"><input className="compact-input" value={form.seo_title} onChange={e=>setForm({...form,seo_title:e.target.value})}/></Field><Field label="Instagram URL"><input className="compact-input" value={form.social_instagram} onChange={e=>setForm({...form,social_instagram:e.target.value})}/></Field><Field label="Facebook URL"><input className="compact-input" value={form.social_facebook} onChange={e=>setForm({...form,social_facebook:e.target.value})}/></Field><Field label="WhatsApp URL"><input className="compact-input" value={form.social_whatsapp} onChange={e=>setForm({...form,social_whatsapp:e.target.value})}/></Field><Field label="SEO Description" wide><textarea className="compact-input" rows={5} value={form.seo_description} onChange={e=>setForm({...form,seo_description:e.target.value})}/></Field></div></Section><Section title="Publish & Preview" meta="Save the complete store configuration and open the customer experience."><div className="sb-publish"><div><b>Ready to publish</b><p>All customer-facing presentation settings are stored against your business store. Restaurant SaaS remains the source of truth for operational catalog and orders.</p></div><div><button className="btn primary" disabled={busy} onClick={saveStore}>{busy?'Saving…':'Save & Publish Store'}</button><a className="btn" href={publicUrl} target="_blank">Open Customer Store ↗</a></div></div></Section></div>}

      {selectedItem&&<div className="sb-modal-backdrop" onClick={()=>setSelectedItem(null)}><div className="sb-modal" onClick={e=>e.stopPropagation()}><button className="sb-close" onClick={()=>setSelectedItem(null)}>×</button><h2>{selectedItem.item_name}</h2><p className="muted">Manage variants and add-ons used by the customer ordering experience.</p><div className="sb-option-section"><h3>Variants</h3>{variants.map(v=><div key={v.id}><span>{v.name} · ₹{v.price}</span><button className="btn" onClick={()=>deleteOption('variant',v.id)}>Delete</button></div>)}<div className="sb-inline"><input className="compact-input" placeholder="Variant name" value={newVariant.name} onChange={e=>setNewVariant({...newVariant,name:e.target.value})}/><input className="compact-input" type="number" placeholder="Price" value={newVariant.price} onChange={e=>setNewVariant({...newVariant,price:e.target.value})}/><button className="btn primary" onClick={()=>addOption('variant')}>Add</button></div></div><div className="sb-option-section"><h3>Add-ons</h3>{addons.map(a=><div key={a.id}><span>{a.name} · ₹{a.price}</span><button className="btn" onClick={()=>deleteOption('addon',a.id)}>Delete</button></div>)}<div className="sb-inline"><input className="compact-input" placeholder="Add-on name" value={newAddon.name} onChange={e=>setNewAddon({...newAddon,name:e.target.value})}/><input className="compact-input" type="number" placeholder="Price" value={newAddon.price} onChange={e=>setNewAddon({...newAddon,price:e.target.value})}/><button className="btn primary" onClick={()=>addOption('addon')}>Add</button></div></div></div></div>}

      <div className="sb-savebar"><span>{saved?'✓ Saved':'Changes are local until you save'}</span><button className="btn primary" disabled={busy} onClick={saveStore}>{busy?'Saving…':'Save Store Settings'}</button><a className="btn" href={publicUrl} target="_blank">Preview ↗</a></div>
     </>:<div className="sb-tab-content">
       <Section title="Hospitality Store Preview" meta="Live HMS data — identity and operational data remain in the canonical hospitality management workspace."><div className="sb-hotel-preview"><div className="sb-hotel-cover" style={{backgroundImage:property?.cover_image?`linear-gradient(90deg,#1a120ccc,#1a120c55),url(${property.cover_image})`:'linear-gradient(120deg,#3d2415,#8b5c32)'}}><div>{property?.logo&&<img src={property.logo} alt=""/>}<div><small>ANAIRA HOSPITALITY MARKETPLACE</small><h2>{property?.name||'Property'}</h2><p>{(property?.hospitality_types||[activeHospitalityType]).map(x=>({hotel:'Hotel',camp:'Camping',homestay:'Homestay',guest_house:'Guest House',cottage:'Cottage'}[x]||x)).join(' · ')}</p><p>{property?.city||''} · Live availability · Direct booking</p></div></div></div><div className="sb-hotel-stats"><b>{hotelRoomTypes.length}<small>{{hotel:'Hotel',camp:'Camp / Tent',homestay:'Homestay',guest_house:'Guest House',cottage:'Cottage'}[activeHospitalityType]||'Accommodation'} Types</small></b><b>{hotelRatePlans.length}<small>Rate Plans</small></b><b>{hotelInventory.length}<small>Inventory Days</small></b><b>{hotelReservations.length}<small>Bookings</small></b></div><div className="sb-hotel-actions"><a className="btn" href={`/hotel-management/setup?type=${activeHospitalityType}`}>Edit Property Profile ↗</a><a className="btn" href={`/hotel-management/room-types?type=${activeHospitalityType}`}>Manage Stay Types ↗</a><a className="btn" href={`/hotel-management/rates?type=${activeHospitalityType}`}>Manage Rates ↗</a><a className="btn" href={`/hotel-management/inventory?type=${activeHospitalityType}`}>Manage Inventory ↗</a><a className="btn primary" href={publicUrl} target="_blank">Open Store ↗</a></div></div></Section>
       <Section title="Hospitality Marketplace QR & Booking Link" meta="Share this property's direct ${hospitalityLabel.toLowerCase()} booking experience"><MarketplaceQR restaurantId={rid} hotelName={property?.name||hospitalityLabel}/></Section>
       <Section title="${hospitalityLabel} SEO" meta="Public discovery metadata"><div className="sb-form-grid"><Field label="SEO Title"><input className="compact-input" value={form.seo_title} onChange={e=>setForm({...form,seo_title:e.target.value})}/></Field><Field label="SEO Description"><textarea className="compact-input" value={form.seo_description} onChange={e=>setForm({...form,seo_description:e.target.value})}/></Field></div><div className="sb-savebar"><button className="btn primary" onClick={saveStore}>Save ${hospitalityLabel} Store Settings</button><a className="btn" href={publicUrl} target="_blank">Preview ↗</a></div></Section>
     </div>}
    </>}
  </div>
  <style jsx global>{`
   .sb-page{max-width:1500px;margin:0 auto;padding:10px 0 80px}.sb-hero{display:flex;justify-content:space-between;gap:24px;align-items:end;padding:30px;border-radius:26px;background:linear-gradient(135deg,#062d22,#0b4a36);color:#fff;box-shadow:0 20px 55px #062d2230}.sb-eyebrow{font-size:10px;letter-spacing:2px;color:#d8b45b;font-weight:900}.sb-hero h1{margin:7px 0;font-size:36px;letter-spacing:-.7px}.sb-hero p{margin:0;color:#cfe0d8;max-width:720px}.sb-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.sb-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}.sb-kpis>div{padding:18px;border:1px solid #e7e0d4;background:#fff;border-radius:18px;box-shadow:0 8px 25px #17352a0b}.sb-kpis span{display:block;font-size:9px;letter-spacing:1.5px;color:#7a817c;font-weight:900}.sb-kpis b{display:block;margin-top:6px;font-size:20px;color:#17352a}.sb-kpis small{display:block;margin-top:5px;color:#8a918d}.sb-tabs{display:grid;grid-template-columns:repeat(8,1fr);gap:8px;margin:18px 0;position:sticky;top:0;z-index:20;background:#f5f3ee;padding:8px 0}.sb-tabs button{text-align:left;border:1px solid #e2dccf;background:#fff;border-radius:15px;padding:12px;cursor:pointer;color:#17352a}.sb-tabs button.active{background:#073b2b;color:#fff;border-color:#073b2b;box-shadow:0 8px 20px #073b2b25}.sb-tabs b{display:block;font-size:12px}.sb-tabs small{display:block;margin-top:4px;opacity:.65;font-size:9px;line-height:1.3}.sb-panel-grid,.sb-tab-content{display:grid;gap:18px}.sb-card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.sb-stat-card{padding:18px;border:1px solid #e6dfd2;border-radius:17px;background:linear-gradient(180deg,#fff,#fbfaf6)}.sb-stat-card span,.sb-stat-card small{display:block;color:#7c847f;font-size:11px}.sb-stat-card strong{display:block;font-size:28px;margin:7px 0;color:#073b2b}.sb-quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.sb-quick-grid button{display:grid;grid-template-columns:40px 1fr 20px;gap:12px;align-items:center;text-align:left;padding:16px;border:1px solid #e7e0d4;background:#fff;border-radius:16px;cursor:pointer}.sb-quick-grid button>span{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:#f3ead6;font-size:20px}.sb-quick-grid b,.sb-quick-grid small{display:block}.sb-quick-grid small{margin-top:4px;color:#777;line-height:1.4}.sb-quick-grid em{font-style:normal;font-size:22px;color:#b08a3f}.sb-info{display:grid;grid-template-columns:180px 1fr;gap:10px;padding:18px;background:#fbfaf6;border:1px solid #e7e0d4;border-radius:16px}.sb-info b{color:#073b2b}.sb-info span{color:#68716b;line-height:1.55}.sb-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.sb-form-grid>label{min-width:0}.sb-form-grid .media-picker{height:100%;box-sizing:border-box}.sb-form-grid .full{grid-column:1/-1}.sb-preview-card{border:1px solid #e5dfd2;border-radius:16px;padding:12px;background:#fbfaf7}.sb-preview-card>span{font-size:11px;font-weight:800;color:#777}.sb-preview-card>div{height:150px;border-radius:13px;margin-top:8px;background-size:cover;background-position:center;display:flex;align-items:end;padding:16px;color:#fff;gap:10px}.sb-preview-card img{width:52px;height:52px;border-radius:12px;object-fit:cover;background:#fff}.sb-banner-list,.sb-list{display:grid;gap:9px;margin-top:15px}.sb-banner-list article,.sb-list>div{display:grid;grid-template-columns:110px 1fr auto;gap:12px;align-items:center;padding:10px;border:1px solid #e8e2d7;border-radius:14px;background:#fff}.sb-banner-list img{width:110px;height:62px;object-fit:cover;border-radius:9px}.sb-banner-list small,.sb-list small{display:block;color:#777;margin-top:4px}.sb-toggle-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.sb-toggle-grid label{display:flex;align-items:center;gap:9px;padding:14px;border:1px solid #e7e0d4;border-radius:14px;background:#fff}.sb-source-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.sb-source-grid button{padding:18px;text-align:left;border:2px solid #e6dfd2;border-radius:16px;background:#fff;cursor:pointer}.sb-source-grid button.selected{border-color:#c69b3c;background:#fff8e8}.sb-source-grid b,.sb-source-grid small{display:block}.sb-source-grid small{margin-top:6px;color:#777;line-height:1.45}.sb-connection-list{display:grid;gap:8px;margin-top:14px}.sb-connection-list>div{padding:12px 14px;border:1px solid #e7e0d4;border-radius:12px;background:#fbfaf7}.sb-connection-list span{display:block;color:#777;margin-top:4px;font-size:12px}.sb-item-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-height:560px;overflow:auto}.sb-item-grid label{display:grid;grid-template-columns:20px 54px 1fr;gap:8px;align-items:center;padding:9px;border:1px solid #e7e0d4;border-radius:12px;background:#fff}.sb-item-grid label.selected{border-color:#c69b3c;background:#fffaf0}.sb-item-grid img,.sb-item-placeholder{width:54px;height:54px;border-radius:9px;object-fit:cover;background:#eee;display:grid;place-items:center}.sb-item-grid small{display:block;color:#777;margin-top:3px}.sb-publish{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:20px;border-radius:18px;background:#f6f1e3;border:1px solid #e8d9b5}.sb-publish p{margin:6px 0 0;color:#6f756f;max-width:720px}.sb-publish>div:last-child{display:flex;gap:8px;flex-wrap:wrap}.sb-savebar{position:sticky;bottom:14px;z-index:25;display:flex;justify-content:flex-end;align-items:center;gap:8px;padding:10px 12px;margin-top:18px;background:#073b2bf2;color:#fff;border-radius:16px;box-shadow:0 14px 40px #0003}.sb-savebar span{margin-right:auto;color:#dbe9e2;font-size:12px}.sb-modal-backdrop{position:fixed;inset:0;background:#0008;z-index:1000;display:grid;place-items:center;padding:20px}.sb-modal{width:min(720px,96vw);max-height:90vh;overflow:auto;background:#fff;border-radius:22px;padding:24px;position:relative}.sb-close{position:absolute;right:15px;top:15px;border:0;background:#eee;border-radius:50%;width:34px;height:34px;font-size:22px}.sb-option-section{margin-top:20px}.sb-option-section>div:not(.sb-inline){display:flex;justify-content:space-between;align-items:center;padding:10px;border-bottom:1px solid #eee}.sb-inline{display:grid;grid-template-columns:1fr 120px auto;gap:8px;margin-top:10px}.sb-hotel-preview{overflow:hidden;border:1px solid #e7dfd4;border-radius:20px;background:#fff}.sb-hotel-cover{height:260px;background-size:cover;background-position:center;color:#fff;display:flex;align-items:end;padding:25px}.sb-hotel-cover>div{display:flex;gap:15px;align-items:center}.sb-hotel-cover img{width:70px;height:70px;object-fit:cover;border-radius:15px;background:#fff;padding:3px}.sb-hotel-cover small{letter-spacing:2px;color:#e7c979}.sb-hotel-cover h2{font-size:32px;margin:5px 0}.sb-hotel-cover p{margin:0;color:#e4ece8}.sb-hotel-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:18px}.sb-hotel-stats>b{font-size:24px;color:#073b2b;text-align:center;padding:10px}.sb-hotel-stats small{display:block;font-size:10px;color:#777;margin-top:4px}.sb-hotel-actions{display:flex;gap:8px;flex-wrap:wrap;padding:0 18px 18px}.media-picker{min-width:0}@media(max-width:1100px){.sb-tabs{grid-template-columns:repeat(4,1fr)}.sb-card-grid{grid-template-columns:repeat(2,1fr)}.sb-item-grid{grid-template-columns:repeat(2,1fr)}.sb-quick-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.sb-hero{display:grid}.sb-kpis{grid-template-columns:repeat(2,1fr)}.sb-tabs{grid-template-columns:repeat(2,1fr);position:static}.sb-form-grid,.sb-source-grid,.sb-toggle-grid,.sb-card-grid{grid-template-columns:1fr}.sb-quick-grid{grid-template-columns:1fr}.sb-info{grid-template-columns:1fr}.sb-item-grid{grid-template-columns:1fr}.sb-banner-list article{grid-template-columns:80px 1fr}.sb-banner-list article img{width:80px}.sb-banner-list article button{grid-column:2}.sb-publish{display:grid}.sb-hotel-stats{grid-template-columns:repeat(2,1fr)}}
  `}</style>
 </AppShell>;
}

export default function StoreBuilderPage() {
 return <Suspense fallback={<div style={{padding:'24px',fontFamily:'system-ui'}}>Loading…</div>}>
  <StoreBuilder />
 </Suspense>;
}
