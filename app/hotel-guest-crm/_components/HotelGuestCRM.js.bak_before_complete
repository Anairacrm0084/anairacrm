 const aiView=<><Section title="AI Guest Insights"><Table columns={['Guest','Type','Summary','Recommendation','Confidence','Date']} rows={(data.ai||[]).map(x=>[nameOf(x.customer_id),safe(x.insight_type),safe(x.summary),safe(x.recommendation),x.confidence?`${(Number(x.confidence)*100).toFixed(0)}%`:'—',fmtDate(x.created_at)])}/></Section><Section title="AI Action Queue" meta="Human approval"><Table columns={['Guest','Action','Status','Proposed Action','Created']} rows={(data.aiQueue||[]).map(x=>[nameOf(x.customer_id),safe(x.action_type),<Badge>{safe(x.status)}</Badge>,JSON.stringify(x.proposed_action||{}),fmtDate(x.created_at)])}/></Section></>;
 const consentView=<><Toolbar search={search} setSearch={setSearch} onAdd={()=>add('consent')} label="Consent"/>{formUI}<Section title="Consent Ledger"><Table columns={['Guest','Channel','Purpose','Status','Captured','Source']} rows={filtered(data.consents||[],['channel','purpose','status','source']).map(c=>[nameOf(c.customer_id),safe(c.channel),safe(c.purpose),<Badge tone={c.status==='withdrawn'||c.status==='denied'?'danger':'success'}>{safe(c.status)}</Badge>,fmtDate(c.captured_at),safe(c.source)])}/></Section></>;
 const integrationsView=<><Section title="Integration Ownership"><div className="grid three"><div className="mini"><b>Booking Engine</b><span>Reservation master</span><Link href="/booking-engine">Open</Link></div><div className="mini"><b>Hotel PMS</b><span>Room/check-in/check-out master</span><Link href="/pms">Open</Link></div><div className="mini"><b>Restaurant POS</b><span>Restaurant transactions</span><Link href="/pos">Open</Link></div><div className="mini"><b>WhatsApp CRM</b><span>Guest communication</span><Link href="/integrations">Open</Link></div><div className="mini"><b>Revenue Management</b><span>Pricing recommendations</span><Link href="/revenue">Open</Link></div><div className="mini"><b>Customer 360</b><span>Canonical identity</span><Link href="/customer-360">Open</Link></div></div></Section><Section title="Data Health"><Table columns={['Source','Records','Status']} rows={[["Guests",customers.length,'LIVE'],['Stays',stays.length,'LIVE'],['Requests',requests.length,'LIVE'],['Complaints',complaints.length,'LIVE'],['Feedback',feedback.length,'LIVE'],['Loyalty Accounts',(data.loyalty||[]).length,'LIVE'],['Pre-arrival Jobs',(data.prearrival||[]).length,'LIVE']]}/></Section></>;
 const settingsView=<><Section title="Hotel Guest CRM Settings"><div className="hgc-settings-grid">{Object.entries(settings).map(([k,v])=><label className="hgc-toggle" key={k}><input type="checkbox" checked={!!v} onChange={e=>setSettings(x=>({...x,[k]:e.target.checked}))}/><span><b>{k.replaceAll('_',' ')}</b><small>{v?'Enabled':'Disabled'}</small></span></label>)}</div><button className="btn primary" disabled={settingsSaving} onClick={saveSettings}>{settingsSaving?'Saving…':'Save Settings'}</button></Section><Section title="Ownership Rules"><div className="notice">CRM owns guest relationship, profile, timeline, preferences and service context. Booking Engine owns reservations. PMS owns room/check-in/check-out operations. POS owns restaurant transactions. Accounting owns books. Revenue Management owns pricing recommendations.</div></Section></>;
