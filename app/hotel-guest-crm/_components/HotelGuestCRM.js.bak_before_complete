function findDuplicates(customers){const byPhone={},byEmail={},out=[],seen=new Set();for(const c of customers){const keys=[];if(c.phone)keys.push(['phone',String(c.phone).replace(/\D/g,'')]);if(c.email)keys.push(['email',String(c.email).trim().toLowerCase()]);for(const [field,key] of keys){const map=field==='phone'?byPhone:byEmail;if(map[key]&&map[key].id!==c.id){const ids=[map[key].id,c.id].sort().join(':');if(!seen.has(ids)){seen.add(ids);out.push({a:map[key],b:c,fields:[field]})}}else if(key)map[key]=c}}return out}

function Guest360({guest,data,nameOf,onClose}){const stays=(data.stays||[]).filter(x=>x.customer_id===guest.id),req=(data.requests||[]).filter(x=>x.customer_id===guest.id),comp=(data.complaints||[]).filter(x=>x.customer_id===guest.id),prefs=(data.preferences||[]).filter(x=>x.customer_id===guest.id),loy=(data.loyalty||[]).find(x=>x.customer_id===guest.id),tasks=(data.tasks||[]).filter(x=>x.customer_id===guest.id),inter=(data.interactions||[]).filter(x=>x.customer_id===guest.id);return <Section title={`Guest 360 — ${guest.full_name}`} meta="Canonical guest relationship view"><div className="hgc-profile-head"><div><h2>{guest.full_name}</h2><p>{safe(guest.phone)} · {safe(guest.email)}</p></div><div>{guest.vip&&<Badge tone="gold">VIP</Badge>} <button className="btn" onClick={onClose}>Close</button></div></div><div className="grid kpis"><Kpi label="Hotel Revenue" value={fmtMoney(guest.total_hotel_revenue)} delta="Lifetime"/><Kpi label="Restaurant Revenue" value={fmtMoney(guest.total_restaurant_revenue)} delta="Customer 360"/><Kpi label="Total Stays" value={guest.total_stays||0} delta="History"/><Kpi label="Loyalty" value={loy?.points_balance||0} delta={loy?.tier||'No account'}/></div><div className="grid two"><div className="mini"><b>Profile</b><span>{safe(guest.customer_type)} · {safe(guest.country)} · {safe(guest.preferred_language)}</span><span>Created {fmtDate(guest.created_at)}</span></div><div className="mini"><b>Preferences</b>{prefs.slice(0,6).map(p=><span key={p.id}>{p.preference_key}: {p.preference_value}</span>)}{!prefs.length&&<span>No preferences recorded.</span>}</div></div><Section title="Stay History"><Table columns={['Check-in','Check-out','Room','Source','Status','Amount']} rows={stays.map(s=>[fmtDate(s.check_in_date),fmtDate(s.check_out_date),safe(s.room_number),safe(s.booking_source),safe(s.booking_status),fmtMoney(s.total_amount)])}/></Section><Section title="Relationship Timeline"><div className="timeline">{[...stays.map(x=>({d:x.check_in_date||x.created_at,t:'Stay',s:`${x.room_number||'Room'} · ${x.booking_status}`,i:'⌂'})),...req.map(x=>({d:x.requested_at,t:'Request',s:x.request_type,i:'⚙'})),...comp.map(x=>({d:x.opened_at,t:'Complaint',s:x.title,i:'⚠'})),...inter.map(x=>({d:x.occurred_at,t:'Interaction',s:x.subject||x.channel,i:'✉'})),...tasks.map(x=>({d:x.created_at,t:'Task',s:x.title,i:'✓'}))].sort((a,b)=>new Date(b.d)-new Date(a.d)).slice(0,30).map((x,i)=><div className="timeline-item" key={i}><div className="timeline-dot">{x.i}</div><div><b>{x.t}</b><p>{x.s}</p><small>{fmtDate(x.d)}</small></div></div>)}</div></Section></Section>}
function TimelineView({stays,requests,complaints,feedback,tasks,interactions,nameOf}){const rows=[...stays.map(x=>({d:x.created_at||x.check_in_date,t:'Stay',g:x.customer_id,s:`${x.booking_status} · ${x.room_number||'Room'} · ${fmtMoney(x.total_amount)}`})),...requests.map(x=>({d:x.requested_at,t:'Request',g:x.customer_id,s:`${x.request_type} · ${x.status}`})),...complaints.map(x=>({d:x.opened_at,t:'Complaint',g:x.customer_id,s:`${x.title} · ${x.status}`})),...feedback.map(x=>({d:x.created_at,t:'Feedback',g:x.customer_id,s:`Rating ${x.overall_rating||'—'} · ${x.source||'manual'}`})),...tasks.map(x=>({d:x.created_at,t:'Task',g:x.customer_id,s:`${x.title} · ${x.status}`})),...interactions.map(x=>({d:x.occurred_at,t:'Interaction',g:x.customer_id,s:`${x.channel} · ${x.subject||x.interaction_type}`}))].sort((a,b)=>new Date(b.d)-new Date(a.d));return <Section title="Unified Guest Timeline" meta={`${rows.length} events`}><Table columns={['Date','Type','Guest','Event']} rows={rows.slice(0,500).map(x=>[fmtDate(x.d),<Badge>{x.t}</Badge>,nameOf(x.g),x.s])}/></Section>}
function Analytics({data,customers,stays,requests,complaints,feedback,upsells,hotelRevenue}){const avg=x=>x.length?(x.reduce((n,v)=>n+Number(v||0),0)/x.length).toFixed(2):'0.00';const repeat=customers.filter(c=>Number(c.total_stays||0)>1).length;const direct=stays.filter(s=>['direct','manual','walk_in'].includes(s.booking_source)).length;const ota=stays.filter(s=>String(s.booking_source||'').toLowerCase().includes('ota')).length;return <><div className="grid kpis"><Kpi label="Guests" value={customers.length} delta="Live"/><Kpi label="Stays" value={stays.length} delta="Live"/><Kpi label="Repeat %" value={customers.length?`${((repeat/customers.length)*100).toFixed(1)}%`:'0%'} delta=">1 stay"/><Kpi label="Hotel Revenue" value={fmtMoney(hotelRevenue)} delta="Guest master"/><Kpi label="Avg Stay" value={fmtMoney(stays.length?stays.reduce((n,s)=>n+Number(s.total_amount||0),0)/stays.length:0)} delta="Average"/><Kpi label="Avg Rating" value={avg(feedback.map(x=>x.overall_rating))} delta="Feedback"/></div><div className="grid three"><Section title="Booking Source"><Table columns={['Source','Stays']} rows={[['Direct',direct],['OTA',ota],['Corporate',stays.filter(s=>s.booking_source==='corporate').length],['Travel Agent',stays.filter(s=>s.booking_source==='travel_agent').length]]}/></Section><Section title="Service"><Table columns={['Metric','Value']} rows={[['Requests',requests.length],['Open requests',requests.filter(x=>!['completed','cancelled'].includes(x.status)).length],['Complaints',complaints.length],['Open complaints',complaints.filter(x=>!['resolved','closed'].includes(x.status)).length]]}/></Section><Section title="Revenue Opportunities"><Table columns={['Metric','Value']} rows={[['Upsell offers',upsells.length],['Accepted upsells',upsells.filter(x=>x.status==='accepted').length],['Upsell revenue',fmtMoney(upsells.filter(x=>x.status==='accepted').reduce((n,x)=>n+Number(x.amount||0),0))],['Feedback records',feedback.length]]}/></Section></div><Section title="Daily CRM Analytics"><Table columns={['Date','Guests','Hotel Revenue','Bookings','Complaints','Feedback','Retention','LTV']} rows={(data.analytics||[]).slice(0,60).map(a=>[fmtDate(a.metric_date),a.customers,fmtMoney(a.hotel_revenue),a.bookings,a.complaints,a.feedback_count,a.retention_rate!=null?`${a.retention_rate}%`:'—',fmtMoney(a.ltv)])}/></Section></>}
